# Build directories
/build/
/dist/
.worktrees/

# Agent entrypoint must be tracked even if ignored globally.
!/AGENTS.md

# IDE files
# 保留项目级 .vscode 配置 (settings.json)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.user
*.pro.user

# Compiled files
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
*.pyc

# Qt generated
moc_*
ui_*
qrc_*
*.qm

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Settings (local)
embeddebug_settings.json
test_output_*.txt
local_env.bat
tools/local_env.bat

# Temp files
*.tmp
*.bak
*.swp
*~

# Dependencies
node_modules/

# Python migration tests use ui_smoke; keep Qt generated ui_* ignored elsewhere.
!tests/python/
!tests/python/ui_smoke/
!tests/python/ui_smoke/**
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.pyinstaller/
*.toc
*.pkg
*.manifest
nul

# 本地环境自动生成的启动脚本（tools/launch_embeddebug.ps1 产物）
# 不应提交；提交面只保留 EmbedDebug.bat 一个用户入口。
local_env.bat

# 临时网络探测脚本
_netprobe*.ps1
