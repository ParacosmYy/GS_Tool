# 共享 Web 时请替换为随机长字符串，不要提交真实 .env。
TOKEN_TRACKER_SECRET_KEY=replace-with-a-long-random-secret
# local 用于个人体验；serve --production 会切换到 production 并强制 HTTPS 预检；
# 可信 HTTP 局域网预览使用显式的 serve --lan-preview。
TOKEN_TRACKER_RUNTIME_MODE=local

# 默认：data/token_tracker.sqlite3。也可以改成绝对路径。
TOKEN_TRACKER_DB=data/token_tracker.sqlite3
TOKEN_TRACKER_HOST=127.0.0.1
TOKEN_TRACKER_PORT=5000

# 代理请求必须命中白名单；多个地址用英文逗号分隔。
# Kimi 官方 OpenAI-compatible Base URL 示例：
# https://api.moonshot.cn/v1
# Kimi Code CLI provider 文档另列的 Moonshot endpoint（请先确认账户/Key 所属平台）：
# https://api.moonshot.ai/v1
# Kimi Code 使用独立的 coding API 与独立 Key：
# https://api.kimi.com/coding/v1
TOKEN_TRACKER_ALLOWED_BASE_URLS=https://api.moonshot.cn/v1,https://api.moonshot.ai/v1,https://api.kimi.com/coding/v1,https://api.openai.com/v1

# 仅在你明确需要访问本机 HTTP provider 时设为 1；公网部署保持 0。
TOKEN_TRACKER_ALLOW_HTTP_PROXY=0

# 如果公网通过 HTTPS 反向代理访问，设为 1。
TOKEN_TRACKER_SECURE_COOKIE=0
TOKEN_TRACKER_PROXY_TIMEOUT=60
# Upper bound for one upstream JSON body; keeps proxy memory use predictable.
TOKEN_TRACKER_PROXY_MAX_RESPONSE_BYTES=2097152

# Optional local OpenAI-compatible Gateway. Keep real values only in the ignored
# windows/.env or process environment; the Gateway never writes these secrets
# to SQLite, logs, command arguments, or the central service.
TOKEN_TRACKER_GATEWAY_PROVIDER_KEY=
TOKEN_TRACKER_GATEWAY_INGEST_TOKEN=
TOKEN_TRACKER_GATEWAY_ACCESS_TOKEN=
