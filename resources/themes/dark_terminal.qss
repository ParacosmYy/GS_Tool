/* EmbedDebug - 暗色终端主题 */

/* 全局背景 */
QMainWindow {
    background-color: #1e1e2e;
}

/* 左侧导航树 */
QTreeView {
    background-color: #181825;
    color: #cdd6f4;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QTreeView::item:hover {
    background-color: #262637;
}

/* 工具栏 */
QToolBar {
    background-color: #1e1e2e;
    border: none;
    border-bottom: 1px solid #313244;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #313244;
    border: 1px solid #45475a;
}

QToolButton:pressed {
    background-color: #45475a;
}

QToolButton:checked {
    background-color: #313244;
    border: 1px solid #89b4fa;
    color: #89b4fa;
}

/* 发送区域 */
QLineEdit {
    background-color: #181825;
    color: #a6e3a1;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #89b4fa;
}

QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #45475a;
}

QPushButton:pressed {
    background-color: #585b70;
}

/* 状态栏 */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
    font-size: 12px;
}

/* 分隔器 */
QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar {
    background-color: #1e1e2e;
    border-top: 1px solid #313244;
}

/* ComboBox */
QComboBox {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #89b4fa;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #313244;
}

/* SpinBox */
QSpinBox {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

/* CheckBox */
QCheckBox {
    color: #cdd6f4;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 3px;
    background-color: #181825;
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border: 1px solid #89b4fa;
}

/* 配置面板标签 */
QLabel {
    color: #bac2de;
    font-size: 13px;
}

QGroupBox {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #b4d0fb; }
QPushButton#otaStartBtn:pressed { background-color: #74a8f7; }
QPushButton#otaStartBtn:disabled { background-color: #45475a; color: #6c7086; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #f38ba8;
    border: 1px solid #f38ba8;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(243,139,168,0.15); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(243,139,168,0.3); }
QPushButton#otaCancelBtn:disabled { color: #45475a; border-color: #45475a; }

QProgressBar#otaProgress {
    background-color: #313244;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #cdd6f4;
}
QProgressBar#otaProgress::chunk {
    background-color: #89b4fa;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #1e1e2e;
    color: #a6adc8;
    border: 1px solid #313244;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #181825;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #6c7086;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #f38ba8; border-color: #f38ba8; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #94e2d5; }
QPushButton#connectBtn[state="connected"] {
    background-color: #f38ba8;
    color: #1e1e2e;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #eba0ac; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #a6e3a1; }
QLabel#connStatus[state="disconnected"] { color: #f38ba8; }
QLabel#connStatus[state="connecting"] { color: #f9e2af; }
QLabel#connStatus[state="error"] { color: #f38ba8; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #a6e3a1; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #a6e3a1; font-size: 11px; }
QLabel#txTotalLabel { color: #f38ba8; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #f38ba8; font-size: 11px; }
QLabel#elapsedLabel { color: #cdd6f4; font-size: 13px; font-family: monospace; }

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #313244; }

QLineEdit#searchBarInput {
    background: #45475a;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #89b4fa;
}
QLineEdit#searchBarInput:focus { border: 1px solid #89b4fa; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #45475a;
    color: #cdd6f4;
    border: 2px solid #f38ba8;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #cdd6f4;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #89b4fa; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #45475a; border: 1px solid #45475a; border-radius: 2px;
}

QLabel#searchBarResult { color: #6c7086; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #f38ba8; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #45475a; color: #cdd6f4;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #89b4fa; }
QPushButton#searchBarCloseBtn:pressed { background: #89b4fa; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #f38ba8; }
