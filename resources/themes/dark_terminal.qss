/* EmbedDebug - 暗色终端主题 */

/* 全局UI字体 - 确保所有控件使用统一字体 */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

/*
 * 语义色板定义 — ThemeManager 从此块解析自绘控件颜色
 * 格式: --semantic-<枚举名>: <颜色值>;
 * TerminalWidget/ChartWidget 等自绘控件通过 ThemeManager::color() 查询
 *
 * 注意: 这些自定义属性声明必须在CSS注释内!
 * Qt的QSS引擎不支持CSS自定义属性(--)语法,
 * 裸露的声明会导致QSS解析器出错，后续样式规则全部失效。
 * ThemeManager使用正则表达式从此注释块中提取颜色定义。
--semantic-BgPrimary: #1e1e2e;
--semantic-BgSecondary: #313244;
--semantic-BgTertiary: #45475a;
--semantic-BgHover: #45475a;
--semantic-TextPrimary: #cdd6f4;
--semantic-TextSecondary: #a6adc8;
--semantic-TextMuted: #6c7086;
--semantic-Accent: #89b4fa;
--semantic-AccentHover: #b4d0fb;
--semantic-AccentPressed: #74a8f7;
--semantic-Border: #313244;
--semantic-BorderFocus: #89b4fa;
--semantic-Success: #a6e3a1;
--semantic-Warning: #f9e2af;
--semantic-Error: #f38ba8;
--semantic-Scrollbar: #45475a;
--semantic-ScrollbarHover: #585b70;
--semantic-TermBackground: #1e1e2e;
--semantic-TermRxText: #cdd6f4;
--semantic-TermTxText: #a6e3a1;
--semantic-TermTimestamp: #9399b2;
--semantic-TermSelection: #45475a;
--semantic-TermSearchHighlight: rgba(249, 226, 175, 80);
--semantic-TermCurrentMatch: rgba(249, 226, 175, 180);
 */


/* 全局背景 */
QMainWindow {
    background-color: #1e1e2e;
}

/* 背景组件 - 透明背景让面板覆盖层可见 */
BackgroundWidget {
    background-color: transparent;
}

/* 面板半透明背景 - 让磨砂玻璃效果和背景图透出来 */
QWidget#serialPanel {
    background-color: rgba(24, 24, 37, 160);
    border-radius: 6px;
}

QWidget#rightWidget {
    background-color: rgba(24, 24, 37, 80);
}

QWidget#rightPanel {
    background-color: transparent;
}

/* 左侧导航树 - 半透明让磨砂玻璃透出 */
QTreeView {
    background-color: rgba(24, 24, 37, 200);
    color: #cdd6f4;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QTreeView::item:hover {
    background-color: #262637;
}

/* 工具栏 */
QToolBar {
    background-color: #1e1e2e;
    border: none;
    border-bottom: 1px solid #313244;
    spacing: 4px;
    padding: 4px;
    min-height: 36px;
    max-height: 40px;
}

QToolButton {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #313244;
    border: 1px solid #45475a;
}

QToolButton:pressed {
    background-color: #45475a;
}

QToolButton:disabled {
    background-color: transparent;
    color: #6c7086;
    border: 1px solid transparent;
}

QToolButton:checked {
    background-color: #313244;
    border: 1px solid #89b4fa;
    color: #89b4fa;
}

/* 发送区域 */
QLineEdit {
    background-color: #181825;
    color: #a6e3a1;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #89b4fa;
}

QLineEdit:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

QLineEdit[hasError="true"] {
    border: 2px solid #f38ba8;
    background-color: rgba(243, 139, 168, 0.05);
}

QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #45475a;
}

QPushButton:pressed {
    background-color: #585b70;
}

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

/* 发送按钮 - accent高亮 */
QPushButton#sendButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#sendButton:hover { background-color: #b4d0fb; }
QPushButton#sendButton:pressed { background-color: #74a8f7; }
QPushButton#sendButton:disabled { background-color: #45475a; color: #6c7086; }

/* 应用定义按钮 - accent高亮 */
QPushButton#applyDefBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#applyDefBtn:hover { background-color: #b4d0fb; }
QPushButton#applyDefBtn:pressed { background-color: #74a8f7; }
QPushButton#applyDefBtn:disabled { background-color: #45475a; color: #6c7086; }

/* 状态栏 */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
    font-size: 12px;
}

QLabel#rxBytesLabel {
    color: #a6e3a1;
    font-size: 12px;
}
QLabel#txBytesLabel {
    color: #f38ba8;
    font-size: 12px;
}
QLabel#connStatusLbl {
    font-size: 12px;
    padding: 0 4px;
}

/* 分隔器 */
QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar,
QWidget#quickCommandBar {
    background-color: #1e1e2e;
    border-top: 1px solid #313244;
}

/* 快捷指令按钮 - 统一样式 */
QPushButton#quickCmdEditBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdEditBtn:hover { background-color: #45475a; }
QPushButton#quickCmdEditBtn:pressed { background-color: #585b70; }
QPushButton#quickCmdEditBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QPushButton#quickCmdAddBtn {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#quickCmdAddBtn:hover { background-color: #45475a; color: #b4d0fb; }
QPushButton#quickCmdAddBtn:pressed { background-color: #585b70; }
QPushButton#quickCmdAddBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* 快捷指令按钮 - 动态命令按钮 (匹配 quickCmdBtn_序号) */
QPushButton[quickCmdBtn="true"] {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton[quickCmdBtn="true"]:hover { background-color: #45475a; border-color: #89b4fa; color: #89b4fa; }
QPushButton[quickCmdBtn="true"]:pressed { background-color: #585b70; }
QPushButton[quickCmdBtn="true"]:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* ComboBox */
QComboBox {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #89b4fa;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid #45475a;
}

QComboBox::down-arrow {
    width: 14px;
    height: 14px;
    image: url(:/icons/dropdown_arrow.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/dropdown_arrow_disabled.svg);
}

QComboBox:disabled {
    background-color: #313244;
    color: #6c7086;
    border: 1px solid #313244;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    color: #cdd6f4;
    selection-background-color: #45475a;
    selection-color: #89b4fa;
    outline: none;
    border: 1px solid #45475a;
    border-radius: 6px;
}

/* 可编辑ComboBox内部QLineEdit使用等宽字体(波特率等数字输入) */
QComboBox QLineEdit {
    font-family: Consolas, "Courier New", monospace;
}

/* SpinBox */
QSpinBox {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QSpinBox:hover {
    border: 1px solid #89b4fa;
}

QSpinBox:focus {
    border: 1px solid #89b4fa;
}

QSpinBox:disabled {
    background-color: #313244;
    color: #6c7086;
    border: 1px solid #313244;
}

/* CheckBox - 统一自定义指示器样式 */
QCheckBox {
    color: #cdd6f4;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 3px;
    background-color: #181825;
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border: 1px solid #89b4fa;
}

QCheckBox::indicator:hover {
    border-color: #89b4fa;
}

QCheckBox::indicator:disabled {
    background-color: #313244;
    border-color: #313244;
}

/* 配置面板标签 */
QLabel {
    color: #bac2de;
    font-size: 13px;
}

/* QGroupBox - 统一标题样式（字体大小、颜色、间距） */
QGroupBox {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #a6adc8;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #b4d0fb; }
QPushButton#otaStartBtn:pressed { background-color: #74a8f7; }
QPushButton#otaStartBtn:disabled { background-color: #45475a; color: #6c7086; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #f38ba8;
    border: 1px solid #f38ba8;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(243,139,168,0.15); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(243,139,168,0.3); }
QPushButton#otaCancelBtn:disabled { color: #45475a; border-color: #45475a; }

QProgressBar#otaProgress {
    background-color: #313244;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #cdd6f4;
}
QProgressBar#otaProgress::chunk {
    background-color: #89b4fa;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #1e1e2e;
    color: #a6adc8;
    border: 1px solid #313244;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #181825;
}

QPushButton#otaBrowseBtn {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 13px;
}
QPushButton#otaBrowseBtn:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton#otaBrowseBtn:pressed { background-color: #585b70; }
QPushButton#otaBrowseBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QLabel#otaFileInfo {
    color: #6c7086;
    font-size: 11px;
}

QLabel#otaStatusLbl {
    color: #a6adc8;
    font-size: 13px;
}
QLabel#otaSpeedLbl {
    color: #a6adc8;
    font-size: 12px;
    font-family: monospace;
}
QLabel#otaEtaLbl {
    color: #6c7086;
    font-size: 12px;
    font-family: monospace;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #6c7086;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #f38ba8; border-color: #f38ba8; }
QPushButton#otaClearHistory:pressed { background-color: rgba(243,139,168,0.15); }
QPushButton#otaClearHistory:disabled { color: #45475a; border-color: #45475a; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #94e2d5; }
QPushButton#connectBtn:pressed { background-color: #94d4c8; }
QPushButton#connectBtn:disabled { background-color: #45475a; color: #6c7086; }
QPushButton#connectBtn[state="connected"] {
    background-color: #f38ba8;
    color: #1e1e2e;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #eba0ac; }
QPushButton#connectBtn[state="connected"]:pressed { background-color: #e09aad; }
QPushButton#connectBtn[state="connected"]:disabled { background-color: #45475a; color: #6c7086; }
QPushButton#connectBtn[state="connecting"] {
    background-color: #f9e2af;
    color: #1e1e2e;
}
QPushButton#connectBtn[state="error"] {
    background-color: #f38ba8;
    color: #1e1e2e;
}
QPushButton#connectBtn[state="error"]:hover { background-color: #f5a0b8; }
QPushButton#connectBtn[state="error"]:pressed { background-color: #e06c8a; }

/* Break信号按钮 — 警告色调标识特殊操作 */
QPushButton#breakBtn {
    background-color: transparent;
    border: 1px solid #fab387;
    border-radius: 4px;
    color: #fab387;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#breakBtn:hover {
    background-color: rgba(250, 179, 135, 0.15);
    border-color: #fab387;
}
QPushButton#breakBtn:pressed {
    background-color: rgba(250, 179, 135, 0.3);
}
QPushButton#breakBtn:disabled {
    background-color: transparent;
    border-color: #45475a;
    color: #45475a;
}

QLabel#driverInfoLbl {
    font-size: 11px;
    color: #6c7086;
    padding: 4px 8px;
    background-color: transparent;
}

QPushButton#refreshBtn {
    background-color: transparent;
    border: 1px solid #45475a;
    border-radius: 4px;
    color: #a6adc8;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#refreshBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
    color: #cdd6f4;
}
QPushButton#refreshBtn:pressed {
    background-color: #45475a;
}
QPushButton#refreshBtn:disabled {
    background-color: transparent;
    border-color: #313244;
    color: #6c7086;
}

/* === SerialConfigPanel 控件 === */
/* DTR/RTS 信号切换按钮 - 绿色=HIGH, 灰色=LOW */
QPushButton#dtrBtn, QPushButton#rtsBtn {
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
    min-width: 80px;
}
/* HIGH 状态 - accent 色(绿) */
QPushButton#dtrBtn[signalState="high"], QPushButton#rtsBtn[signalState="high"] {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border-color: #a6e3a1;
}
QPushButton#dtrBtn[signalState="high"]:hover, QPushButton#rtsBtn[signalState="high"]:hover {
    background-color: #94e2d5;
    border-color: #94e2d5;
}
QPushButton#dtrBtn[signalState="high"]:pressed, QPushButton#rtsBtn[signalState="high"]:pressed {
    background-color: #7dcfaa;
    border-color: #7dcfaa;
}
/* LOW 状态 - bg-tertiary 色(灰) */
QPushButton#dtrBtn[signalState="low"], QPushButton#rtsBtn[signalState="low"] {
    background-color: #45475a;
    color: #a6adc8;
    border-color: #45475a;
}
QPushButton#dtrBtn[signalState="low"]:hover, QPushButton#rtsBtn[signalState="low"]:hover {
    background-color: #585b70;
    border-color: #585b70;
}
QPushButton#dtrBtn[signalState="low"]:pressed, QPushButton#rtsBtn[signalState="low"]:pressed {
    background-color: #6c7086;
    border-color: #6c7086;
}
/* 禁用状态 - 未连接时 */
QPushButton#dtrBtn:disabled, QPushButton#rtsBtn:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

/* === SerialConfigPanel 信号线状态LED === */
QLabel#signalLed {
    color: #6c7086;
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 3px;
    font-size: 10px;
    font-weight: bold;
}
QLabel#signalLed[active="true"] {
    color: #1e1e2e;
    background-color: #a6e3a1;
    border-color: #a6e3a1;
}
QLabel#signalLed[active="false"] {
    color: #6c7086;
    background-color: #313244;
    border-color: #45475a;
}

/* === 发送栏控件 === */
QFrame#sendBarFrame {
    background-color: rgba(24, 24, 37, 180);
    border-top: 1px solid #313244;
}
QComboBox#sendModeCombo, QComboBox#newlineCombo {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cdd6f4;
    font-size: 12px;
}
QComboBox#sendModeCombo:hover, QComboBox#newlineCombo:hover {
    border-color: #89b4fa;
}
QComboBox#sendModeCombo:disabled, QComboBox#newlineCombo:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}
QComboBox#sendModeCombo::drop-down, QComboBox#newlineCombo::drop-down {
    border: none;
    width: 20px;
}

/* === 工具栏显示模式下拉 === */
QComboBox#displayModeCombo {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cdd6f4;
    font-size: 12px;
}
QComboBox#displayModeCombo:hover { border-color: #89b4fa; }
QComboBox#displayModeCombo:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #a6e3a1; }
QLabel#connStatus[state="disconnected"] { color: #f38ba8; }
QLabel#connStatus[state="connecting"] { color: #f9e2af; }
QLabel#connStatus[state="error"] { color: #f38ba8; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #a6e3a1; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #a6e3a1; font-size: 11px; }
QLabel#txTotalLabel { color: #f38ba8; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #f38ba8; font-size: 11px; }
QLabel#peakRateLabel { color: #89b4fa; font-size: 12px; font-weight: bold; }
QLabel#elapsedLabel { color: #cdd6f4; font-size: 13px; font-family: monospace; }
QLabel#errorLabel {
    color: #f38ba8;
    font-size: 12px;
    background-color: rgba(243, 139, 168, 0.08);
    border: 1px solid rgba(243, 139, 168, 0.3);
    border-radius: 4px;
    padding: 6px 8px;
}

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #313244; }

QLineEdit#searchBarInput {
    background: #45475a;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #89b4fa;
}
QLineEdit#searchBarInput:focus { border: 1px solid #89b4fa; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #45475a;
    color: #cdd6f4;
    border: 2px solid #f38ba8;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #cdd6f4;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #89b4fa; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #45475a; border: 1px solid #45475a; border-radius: 2px;
}

QLabel#searchBarResult { color: #6c7086; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #f38ba8; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #45475a; color: #cdd6f4;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #89b4fa; }
QPushButton#searchBarCloseBtn:pressed { background: #89b4fa; }
QPushButton#searchBarCloseBtn:disabled { background: #45475a; color: #6c7086; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #f38ba8; }

/* === ProtocolView 协议解析面板 === */
QWidget#protocolView { background-color: #1e1e2e; }
QWidget#protocolToolbar {
    background-color: #1e1e2e;
    border-bottom: 1px solid #313244;
}
QLabel#protocolStatusLabel {
    color: #a6adc8;
    font-size: 12px;
}
QPushButton#protocolClearBtn,
QPushButton#protocolExportBtn {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#protocolClearBtn:hover,
QPushButton#protocolExportBtn:hover { background-color: #313244; border-color: #89b4fa; color: #89b4fa; }
QPushButton#protocolClearBtn:pressed,
QPushButton#protocolExportBtn:pressed { background-color: #45475a; }
QPushButton#protocolClearBtn:disabled,
QPushButton#protocolExportBtn:disabled { background-color: transparent; color: #6c7086; border-color: #313244; }

QTableView#protocolTable {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    color: #cdd6f4;
    border: none;
    gridline-color: #313244;
    font-size: 12px;
    selection-background-color: #313244;
    selection-color: #89b4fa;
}
QTableView#protocolTable::item {
    padding: 4px 8px;
}

/* ProtocolView 右键上下文菜单 */
QMenu#protocolContextMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu#protocolContextMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu#protocolContextMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}
QMenu#protocolContextMenu::item:disabled {
    color: #6c7086;
}
QMenu#protocolContextMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* === FrameVisualEditor 帧编辑器 === */
QGroupBox#frameHeaderGroup,
QGroupBox#frameLengthGroup,
QGroupBox#frameChecksumGroup,
QGroupBox#frameFieldGroup {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QTableWidget#frameFieldTable {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    gridline-color: #313244;
    font-size: 12px;
    selection-background-color: #313244;
}
QTableWidget#frameFieldTable::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    border: 1px solid #313244;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#frameAddFieldBtn {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameAddFieldBtn:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton#frameAddFieldBtn:pressed { background-color: #585b70; }
QPushButton#frameAddFieldBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QPushButton#frameRemoveFieldBtn {
    background-color: #313244;
    color: #f38ba8;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameRemoveFieldBtn:hover { background-color: #45475a; border-color: #f38ba8; }
QPushButton#frameRemoveFieldBtn:pressed { background-color: #585b70; }
QPushButton#frameRemoveFieldBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QPushButton#frameMoveUpBtn,
QPushButton#frameMoveDownBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameMoveUpBtn:hover,
QPushButton#frameMoveDownBtn:hover { background-color: #45475a; border-color: #89b4fa; color: #89b4fa; }
QPushButton#frameMoveUpBtn:pressed,
QPushButton#frameMoveDownBtn:pressed { background-color: #585b70; }
QPushButton#frameMoveUpBtn:disabled,
QPushButton#frameMoveDownBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QGroupBox#framePreviewGroup {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QLabel#framePreviewLabel {
    color: #a6adc8;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 4px;
    padding: 8px;
}

/* === PanelManager 面板容器 - 透明背景让面板内容自主控制 === */
QWidget#serialConfigPanel,
QWidget#dataStatsPanel,
QWidget#protocolViewPanel,
QWidget#frameEditorPanel,
QWidget#chartWidgetPanel,
QWidget#otaWidgetPanel,
QWidget#terminalPanel,
QWidget#searchBarPanel,
QWidget#bookmarkWidgetPanel {
    background-color: transparent;
}

/* === 背景设置弹出面板 === */
QWidget#bgSettingsPopup {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 6px;
}
QSlider#bgBlurSlider, QSlider#bgOpacitySlider {
    background: transparent;
    min-height: 20px;
}
QSlider#bgBlurSlider::groove:horizontal, QSlider#bgOpacitySlider::groove:horizontal {
    height: 4px;
    background: #45475a;
    border-radius: 2px;
}
QSlider#bgBlurSlider::handle:horizontal, QSlider#bgOpacitySlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #89b4fa;
    border-radius: 7px;
}
QSlider#bgBlurSlider::handle:horizontal:hover, QSlider#bgOpacitySlider::handle:horizontal:hover {
    background: #b4d0fb;
}

QSlider#bgBlurSlider::handle:horizontal:disabled, QSlider#bgOpacitySlider::handle:horizontal:disabled {
    background: #585b70;
}

QPushButton#bgSelectImageBtn {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgSelectImageBtn:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton#bgSelectImageBtn:pressed { background-color: #585b70; }
QPushButton#bgSelectImageBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QPushButton#bgResetBtn {
    background-color: transparent;
    color: #6c7086;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgResetBtn:hover { color: #f38ba8; border-color: #f38ba8; }
QPushButton#bgResetBtn:pressed { background-color: rgba(243,139,168,0.15); }
QPushButton#bgResetBtn:disabled { color: #45475a; border-color: #45475a; }

/* === QScrollBar 滚动条 - 现代极细圆角风格 === */

/* 垂直滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #45475a;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #585b70;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #45475a;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #585b70;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* === QToolTip 工具提示 === */
QToolTip {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* === QMenu 通用菜单样式 - 所有菜单统一风格 === */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}
QMenu::item:disabled {
    color: #6c7086;
}
QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* === TerminalWidget 右键菜单 === */
QMenu#terminalContextMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu#terminalContextMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu#terminalContextMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}
QMenu#terminalContextMenu::item:disabled {
    color: #6c7086;
}
QMenu#terminalContextMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* === SerialConfigPanel 连接状态指示器(彩色圆点) === */
QLabel#statusIndicator {
    background-color: #6c7086;
    border: none;
    border-radius: 4px;
}
QLabel#statusIndicator[state="connected"] {
    background-color: #a6e3a1;
}
QLabel#statusIndicator[state="connecting"] {
    background-color: #f9e2af;
}
QLabel#statusIndicator[state="disconnected"] {
    background-color: #6c7086;
}
QLabel#statusIndicator[state="error"] {
    background-color: #f38ba8;
}

/* === 工具栏下拉框 - 布局/主题/语言选择 === */
QComboBox#layoutCombo,
QComboBox#themeCombo,
QComboBox#langCombo {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cdd6f4;
    font-size: 12px;
    min-width: 80px;
}
QComboBox#layoutCombo:hover,
QComboBox#themeCombo:hover,
QComboBox#langCombo:hover {
    border-color: #89b4fa;
}
QComboBox#layoutCombo:disabled,
QComboBox#themeCombo:disabled,
QComboBox#langCombo:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

/* === 波形图 (ChartWidget) === */

/* 图表控制栏背景 */
QWidget#chartToolbar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
}

/* 图表区域背景 - 与面板底色协调 */
QChartView {
    background-color: #1e1e2e;
}

/* 暂停按钮 - checked 时显示 accent 色表示"暂停中" */
QPushButton#chartPauseBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
QPushButton#chartPauseBtn:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton#chartPauseBtn:pressed { background-color: #585b70; }
QPushButton#chartPauseBtn:checked {
    background-color: #89b4fa;
    color: #1e1e2e;
    border-color: #89b4fa;
    font-weight: bold;
}
QPushButton#chartPauseBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* 清除按钮 */
QPushButton#chartClearBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
QPushButton#chartClearBtn:hover { background-color: #45475a; border-color: #f38ba8; color: #f38ba8; }
QPushButton#chartClearBtn:pressed { background-color: #585b70; }
QPushButton#chartClearBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* 窗口大小下拉框 */
QComboBox#chartWindowCombo {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 3px 8px;
    color: #cdd6f4;
    font-size: 12px;
}
QComboBox#chartWindowCombo:hover { border-color: #89b4fa; }
QComboBox#chartWindowCombo::drop-down { border: none; width: 20px; }
QComboBox#chartWindowCombo:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* 状态标签 */
QLabel#chartStatusLabel {
    color: #6c7086;
    font-size: 11px;
}

/* === QuickCommandBar 编辑对话框 === */
QDialog#quickCmdEditDlg {
    background-color: #1e1e2e;
}

QTableWidget#quickCmdEditTable {
    background-color: #181825;
    alternate-background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    gridline-color: #313244;
    font-size: 12px;
    selection-background-color: #313244;
    selection-color: #89b4fa;
}
QTableWidget#quickCmdEditTable::item {
    padding: 4px 6px;
}

QPushButton#quickCmdAddRowBtn {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdAddRowBtn:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton#quickCmdAddRowBtn:pressed { background-color: #585b70; }
QPushButton#quickCmdAddRowBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

QPushButton#quickCmdDelRowBtn {
    background-color: #313244;
    color: #f38ba8;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdDelRowBtn:hover { background-color: #45475a; border-color: #f38ba8; }
QPushButton#quickCmdDelRowBtn:pressed { background-color: #585b70; }
QPushButton#quickCmdDelRowBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* === BookmarkWidget 书签管理面板 === */
QWidget#bookmarkWidget {
    background-color: transparent;
}

/* 标题标签 */
QLabel#bookmarkTitleLabel {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 0px;
}

/* 书签列表 */
QListWidget#bookmarkList {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 4px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    outline: none;
}
QListWidget#bookmarkList::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1e1e2e;
}
QListWidget#bookmarkList::item:selected {
    background-color: #313244;
    color: #89b4fa;
}
QListWidget#bookmarkList::item:hover {
    background-color: #262637;
}

/* 添加书签按钮 - accent 主操作 */
QPushButton#bookmarkAddBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#bookmarkAddBtn:hover { background-color: #b4d0fb; }
QPushButton#bookmarkAddBtn:pressed { background-color: #74a8f7; }
QPushButton#bookmarkAddBtn:disabled { background-color: #45475a; color: #6c7086; }

/* 删除选中书签按钮 - 次要操作 */
QPushButton#bookmarkRemoveBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#bookmarkRemoveBtn:hover { background-color: #45475a; border-color: #f38ba8; color: #f38ba8; }
QPushButton#bookmarkRemoveBtn:pressed { background-color: #585b70; }
QPushButton#bookmarkRemoveBtn:disabled { background-color: #313244; color: #6c7086; border-color: #313244; }

/* 清空所有书签按钮 - 危险操作 */
QPushButton#bookmarkClearBtn {
    background-color: transparent;
    color: #6c7086;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#bookmarkClearBtn:hover { color: #f38ba8; border-color: #f38ba8; }
QPushButton#bookmarkClearBtn:pressed { background-color: rgba(243,139,168,0.15); }
QPushButton#bookmarkClearBtn:disabled { color: #45475a; border-color: #45475a; }

/* 添加书签对话框 */
QDialog#bookmarkAddDlg {
    background-color: #1e1e2e;
}
QLabel#bookmarkDlgHint {
    color: #a6adc8;
    font-size: 12px;
}
QLineEdit#bookmarkLabelInput {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
}
QLineEdit#bookmarkLabelInput:focus {
    border: 1px solid #89b4fa;
}

/* === NavIndicatorWidget 导航树滑动指示器 === */
/* 控件使用 QPainter 自绘，WA_TranslucentBackground 已在代码中设置 */
/* QSS 仅确保透明背景，不干扰自绘内容 */
QWidget#navIndicator {
    background-color: transparent;
}

/* === ToastWidget 通知吐司 === */
/* 控件使用 QPainter 自绘全部内容（背景、左边框、图标、文字） */
/* WA_TranslucentBackground 已在代码中设置，QSS 提供透明基底 */
/* 语义色由 ThemeManager::SemanticColor 提供:
 *   Success -> #a6e3a1 (绿), Error -> #f38ba8 (红), Accent -> #89b4fa (蓝)
 * 若未来改为子控件布局，以下 QSS 规则提供后备样式 */
QWidget#toastWidget {
    background-color: transparent;
}
QWidget#toastWidget[type="success"] {
    background-color: transparent;
}
QWidget#toastWidget[type="error"] {
    background-color: transparent;
}
QWidget#toastWidget[type="info"] {
    background-color: transparent;
}
/* 后备: 若 ToastWidget 改用 QLabel 子控件 */
QLabel#toastLabel {
    color: #cdd6f4;
    font-size: 13px;
}
/* 后备: 若 ToastWidget 改用 QPushButton 关闭按钮 */
QPushButton#toastCloseBtn {
    background-color: transparent;
    color: #a6adc8;
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#toastCloseBtn:hover {
    background-color: #45475a;
    color: #cdd6f4;
}
QPushButton#toastCloseBtn:pressed {
    background-color: #585b70;
}

/* === NavIndicatorWidget 导航树滑动指示器动画过渡 === */
/* QPropertyAnimation 驱动 indicatorY 属性, 250ms OutCubic */
/* 指示线颜色从 ThemeManager::Accent 获取, 主题切换时 updateThemeColor() 刷新 */
/* 切换动画: m_slideAnim->setDuration(250); setEasingCurve(OutCubic) */

/* === TerminalSearchBar 搜索栏展开/收起动画过渡 === */
/* 展开动画: maximumHeight 0->36, 200ms, OutCubic */
/* 收起动画: maximumHeight 36->0, 150ms, InCubic */
/* 代码使用 QPropertyAnimation 驱动, QSS 无需额外属性 */

/* === PanelManager 面板切换淡入/淡出过渡 === */
/* 淡入: QGraphicsOpacityEffect opacity 0->1, 250ms, OutCubic */
/* 淡出: QGraphicsOpacityEffect opacity 1->0, 200ms, InCubic */
/* 代码使用 QPropertyAnimation + QGraphicsOpacityEffect 驱动 */

/* === 主窗口导航树 (objectName 钩子) === */
QTreeView#navTree {
    background-color: rgba(24, 24, 37, 200);
    color: #cdd6f4;
    border: none;
    outline: none;
    font-size: 13px;
}

/* === 主窗口分割器 === */
QSplitter#mainSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* === 终端容器和分割器 === */
QWidget#terminalContainer {
    background-color: transparent;
}
QSplitter#terminalSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* === 图表区域 QChartView === */
QWidget#chartView {
    background-color: #1e1e2e;
}
QLabel#chartWindowLabel {
    color: #6c7086;
    font-size: 12px;
}

/* === 工具栏 (objectName 钩子) === */
QToolBar#mainToolbar {
    background-color: #1e1e2e;
    border: none;
    border-bottom: 1px solid #313244;
    spacing: 4px;
    padding: 4px;
    min-height: 36px;
    max-height: 40px;
}

/* === 背景设置弹出面板子控件 === */
QLabel#bgBlurLabel, QLabel#bgOpacityLabel {
    color: #cdd6f4;
    font-size: 12px;
}
QLabel#bgBlurValueLabel, QLabel#bgOpacityValueLabel {
    color: #a6adc8;
    font-size: 11px;
    font-family: Consolas, monospace;
}
QCheckBox#bgRippleCheck {
    color: #cdd6f4;
    spacing: 6px;
}
QFrame#bgSeparator {
    background-color: #313244;
    max-height: 1px;
    border: none;
}

/* === OTA 分组框 === */
QGroupBox#otaFileGroup,
QGroupBox#otaConfigGroup,
QGroupBox#otaProgressGroup,
QGroupBox#otaLogGroup,
QGroupBox#otaHistoryGroup {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
    font-size: 13px;
}

/* === OTA 子控件 === */
QLineEdit#otaFileLabel {
    background-color: #181825;
    color: #a6adc8;
    border: 1px solid #313244;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
QComboBox#otaProtocolCombo {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
QComboBox#otaProtocolCombo:hover { border-color: #89b4fa; }
QComboBox#otaProtocolCombo:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

/* === 帧编辑器子控件 === */
QLineEdit#frameHeaderEdit,
QLineEdit#frameFooterEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}
QLineEdit#frameHeaderEdit:focus,
QLineEdit#frameFooterEdit:focus {
    border: 1px solid #89b4fa;
}
QSpinBox#frameLengthOffsetSpin,
QSpinBox#frameChecksumOffsetSpin,
QSpinBox#frameChecksumStartSpin,
QSpinBox#frameLengthAdjustSpin {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
}
QComboBox#frameLengthSizeCombo,
QComboBox#frameChecksumTypeCombo {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
}
QComboBox#frameLengthSizeCombo:hover,
QComboBox#frameChecksumTypeCombo:hover { border-color: #89b4fa; }
QCheckBox#frameLengthEndianCheck {
    color: #cdd6f4;
    spacing: 6px;
}
QComboBox#fieldTypeCombo,
QComboBox#fieldEndianCombo {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
}

/* === 串口配置面板分组 === */
QGroupBox#portGroup,
QGroupBox#paramGroup,
QGroupBox#signalGroup {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
    font-size: 13px;
}
QComboBox#portCombo,
QComboBox#baudCombo,
QComboBox#dataBitsCombo,
QComboBox#parityCombo,
QComboBox#stopBitsCombo,
QComboBox#flowControlCombo {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}
QComboBox#portCombo:hover,
QComboBox#baudCombo:hover,
QComboBox#dataBitsCombo:hover,
QComboBox#parityCombo:hover,
QComboBox#stopBitsCombo:hover,
QComboBox#flowControlCombo:hover { border-color: #89b4fa; }
QComboBox#portCombo:disabled,
QComboBox#baudCombo:disabled,
QComboBox#dataBitsCombo:disabled,
QComboBox#parityCombo:disabled,
QComboBox#stopBitsCombo:disabled,
QComboBox#flowControlCombo:disabled {
    background-color: #313244;
    color: #6c7086;
    border-color: #313244;
}

/* === 对话框按钮容器 === */
QDialogButtonBox#quickCmdDlgButtons,
QDialogButtonBox#bookmarkDlgButtons {
    background-color: transparent;
}
