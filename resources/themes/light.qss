/* EmbedDebug - 浅色主题 (明亮风格) */

/*
 * 语义色板定义 — ThemeManager 从此块解析自绘控件颜色
 */
--semantic-BgPrimary: #ffffff;
--semantic-BgSecondary: #f3f4f6;
--semantic-BgTertiary: #e5e7eb;
--semantic-BgHover: #e5e7eb;
--semantic-TextPrimary: #1f2937;
--semantic-TextSecondary: #4b5563;
--semantic-TextMuted: #9ca3af;
--semantic-Accent: #3b82f6;
--semantic-AccentHover: #60a5fa;
--semantic-AccentPressed: #2563eb;
--semantic-Border: #d1d5db;
--semantic-BorderFocus: #3b82f6;
--semantic-Success: #22c55e;
--semantic-Warning: #f59e0b;
--semantic-Error: #ef4444;
--semantic-Scrollbar: #d1d5db;
--semantic-ScrollbarHover: #9ca3af;
--semantic-TermBackground: #ffffff;
--semantic-TermRxText: #1f2937;
--semantic-TermTxText: #16a34a;
--semantic-TermTimestamp: #9ca3af;
--semantic-TermSelection: #bfdbfe;
--semantic-TermSearchHighlight: rgba(245, 158, 11, 80);
--semantic-TermCurrentMatch: rgba(245, 158, 11, 180);


/* 全局背景 */
QMainWindow {
    background-color: #ffffff;
}

BackgroundWidget {
    background-color: transparent;
}

/* 面板半透明背景 - 让磨砂玻璃效果和背景图透出来（浅色主题使用白色半透明） */
QWidget#serialPanel {
    background-color: rgba(255, 255, 255, 180);
    border-radius: 6px;
}

QWidget#rightWidget {
    background-color: rgba(255, 255, 255, 140);
}

QWidget#rightPanel {
    background-color: transparent;
}

/* 左侧导航树 */
QTreeView {
    background-color: #f3f4f6;
    color: #1f2937;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
}

QTreeView::item:hover {
    background-color: #e5e7eb;
}

/* 工具栏 */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #1f2937;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
}

QToolButton:pressed {
    background-color: #e5e7eb;
}

QToolButton:disabled {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid transparent;
}

QToolButton:checked {
    background-color: #dbeafe;
    border: 1px solid #3b82f6;
    color: #1d4ed8;
}

/* 发送区域 */
QLineEdit {
    background-color: #ffffff;
    color: #166534;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
}

QPushButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #e5e7eb;
}

QPushButton:pressed {
    background-color: #d1d5db;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* 发送按钮 - 主题色高亮 */
QPushButton#sendButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #2563eb;
}

QPushButton#sendButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#sendButton:disabled { background-color: #d1d5db; color: #9ca3af; }

/* 应用定义按钮 - accent高亮 */
QPushButton#applyDefBtn {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#applyDefBtn:hover { background-color: #2563eb; }
QPushButton#applyDefBtn:pressed { background-color: #1d4ed8; }
QPushButton#applyDefBtn:disabled { background-color: #d1d5db; color: #9ca3af; }

/* 状态栏 */
QStatusBar {
    background-color: #f3f4f6;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    font-size: 12px;
}
QLabel#rxBytesLabel { color: #16a34a; font-size: 12px; }
QLabel#txBytesLabel { color: #dc2626; font-size: 12px; }
QLabel#connStatusLbl { font-size: 12px; padding: 0 4px; }

/* 分隔器 */
QSplitter::handle {
    background-color: #e5e7eb;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar,
QWidget#quickCommandBar {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
}

/* 快捷指令按钮 - 统一样式 */
QPushButton#quickCmdEditBtn {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdEditBtn:hover { background-color: #e5e7eb; }
QPushButton#quickCmdEditBtn:pressed { background-color: #d1d5db; }
QPushButton#quickCmdEditBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

QPushButton#quickCmdAddBtn {
    background-color: #f3f4f6;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#quickCmdAddBtn:hover { background-color: #e5e7eb; color: #2563eb; }
QPushButton#quickCmdAddBtn:pressed { background-color: #d1d5db; }
QPushButton#quickCmdAddBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

/* 快捷指令按钮 - 动态命令按钮 */
QPushButton[quickCmdBtn="true"] {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton[quickCmdBtn="true"]:hover { background-color: #e5e7eb; border-color: #3b82f6; color: #1d4ed8; }
QPushButton[quickCmdBtn="true"]:pressed { background-color: #d1d5db; }
QPushButton[quickCmdBtn="true"]:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #3b82f6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid #d1d5db;
}

QComboBox::down-arrow {
    width: 14px;
    height: 14px;
    image: url(:/icons/dropdown_arrow_light.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/dropdown_arrow_light_disabled.svg);
}

QComboBox:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    selection-background-color: #dbeafe;
}

/* SpinBox */
QSpinBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QSpinBox:hover {
    border: 1px solid #3b82f6;
}

QSpinBox:focus {
    border: 1px solid #3b82f6;
}

QSpinBox:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

/* CheckBox - 统一自定义指示器样式 */
QCheckBox {
    color: #1f2937;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border: 1px solid #3b82f6;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:disabled {
    background-color: #f3f4f6;
    border-color: #e5e7eb;
}

/* 配置面板标签 */
QLabel {
    color: #374151;
    font-size: 13px;
}

/* QGroupBox - 统一标题样式（字体大小、颜色、间距） */
QGroupBox {
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #6b7280;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #2563eb; }
QPushButton#otaStartBtn:pressed { background-color: #1d4ed8; }
QPushButton#otaStartBtn:disabled { background-color: #d1d5db; color: #9ca3af; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #ef4444;
    border: 1px solid #ef4444;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(239,68,68,0.1); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(239,68,68,0.2); }
QPushButton#otaCancelBtn:disabled { color: #d1d5db; border-color: #d1d5db; }

QProgressBar#otaProgress {
    background-color: #f3f4f6;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #374151;
}
QProgressBar#otaProgress::chunk {
    background-color: #3b82f6;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #ffffff;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #f9fafb;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #ef4444; border-color: #ef4444; }
QPushButton#otaClearHistory:pressed { background-color: rgba(239,68,68,0.1); }
QPushButton#otaClearHistory:disabled { color: #d1d5db; border-color: #d1d5db; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #22c55e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #16a34a; }
QPushButton#connectBtn:pressed { background-color: #15803d; }
QPushButton#connectBtn:disabled { background-color: #d1d5db; color: #9ca3af; }
QPushButton#connectBtn[state="connected"] {
    background-color: #ef4444;
    color: #ffffff;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #dc2626; }
QPushButton#connectBtn[state="connected"]:pressed { background-color: #b91c1c; }
QPushButton#connectBtn[state="connected"]:disabled { background-color: #d1d5db; color: #9ca3af; }
QPushButton#connectBtn[state="connecting"] {
    background-color: #f59e0b;
    color: #ffffff;
}

QLabel#driverInfoLbl {
    font-size: 11px;
    color: #6b7280;
    padding: 4px;
}

QPushButton#refreshBtn {
    background-color: transparent;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    color: #6b7280;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#refreshBtn:hover {
    background-color: #e5e7eb;
    border-color: #3b82f6;
    color: #374151;
}
QPushButton#refreshBtn:pressed { background-color: #d1d5db; }
QPushButton#refreshBtn:disabled {
    background-color: transparent;
    border-color: #e5e7eb;
    color: #9ca3af;
}

/* === SerialConfigPanel 控件 === */
QCheckBox#dtrCheck, QCheckBox#rtsCheck {
    spacing: 6px;
    color: #111827;
    font-size: 13px;
}
QCheckBox#dtrCheck::indicator, QCheckBox#rtsCheck::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #9ca3af;
    background-color: #ffffff;
}
QCheckBox#dtrCheck::indicator:checked, QCheckBox#rtsCheck::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}
QCheckBox#dtrCheck::indicator:hover, QCheckBox#rtsCheck::indicator:hover {
    border-color: #3b82f6;
}

/* === 发送栏控件 === */
QFrame#sendBarFrame {
    background-color: rgba(255, 255, 255, 180);
    border-top: 1px solid #e5e7eb;
}
QComboBox#sendModeCombo, QComboBox#newlineCombo {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    color: #111827;
    font-size: 12px;
}
QComboBox#sendModeCombo:hover, QComboBox#newlineCombo:hover {
    border-color: #3b82f6;
}
QComboBox#sendModeCombo::drop-down, QComboBox#newlineCombo::drop-down {
    border: none;
    width: 20px;
}

/* === 工具栏显示模式下拉 === */
QComboBox#displayModeCombo {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    color: #111827;
    font-size: 12px;
}
QComboBox#displayModeCombo:hover { border-color: #3b82f6; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #22c55e; }
QLabel#connStatus[state="disconnected"] { color: #dc2626; }
QLabel#connStatus[state="connecting"] { color: #f59e0b; }
QLabel#connStatus[state="error"] { color: #dc2626; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #22c55e; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #22c55e; font-size: 11px; }
QLabel#txTotalLabel { color: #ef4444; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #ef4444; font-size: 11px; }
QLabel#elapsedLabel { color: #374151; font-size: 13px; font-family: monospace; }

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #f3f4f6; }

QLineEdit#searchBarInput {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #3b82f6;
}
QLineEdit#searchBarInput:focus { border: 1px solid #3b82f6; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #ffffff;
    color: #1f2937;
    border: 2px solid #ef4444;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #1f2937;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #3b82f6; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #f3f4f6; border: 1px solid #d1d5db; border-radius: 2px;
}

QLabel#searchBarResult { color: #6b7280; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #ef4444; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #e5e7eb; color: #374151;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #3b82f6; color: #ffffff; }
QPushButton#searchBarCloseBtn:pressed { background: #2563eb; color: #ffffff; }
QPushButton#searchBarCloseBtn:disabled { background: #d1d5db; color: #9ca3af; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #ef4444; }

/* === ProtocolView 协议解析面板 === */
QWidget#protocolView { background-color: #ffffff; }
QWidget#protocolToolbar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}
QLabel#protocolStatusLabel {
    color: #6b7280;
    font-size: 12px;
}
QPushButton#protocolClearBtn,
QPushButton#protocolExportBtn {
    background-color: transparent;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#protocolClearBtn:hover,
QPushButton#protocolExportBtn:hover { background-color: #f3f4f6; border-color: #3b82f6; color: #3b82f6; }
QPushButton#protocolClearBtn:pressed,
QPushButton#protocolExportBtn:pressed { background-color: #e5e7eb; }
QPushButton#protocolClearBtn:disabled,
QPushButton#protocolExportBtn:disabled { background-color: transparent; color: #9ca3af; border-color: #e5e7eb; }

QTableView#protocolTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #374151;
    border: none;
    gridline-color: #e5e7eb;
    font-size: 12px;
    selection-background-color: #eff6ff;
    selection-color: #3b82f6;
}
QTableView#protocolTable::item {
    padding: 4px 8px;
}

/* ProtocolView 右键上下文菜单 */
QMenu#protocolContextMenu {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu#protocolContextMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu#protocolContextMenu::item:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
}
QMenu#protocolContextMenu::item:disabled {
    color: #9ca3af;
}
QMenu#protocolContextMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 8px;
}

/* === FrameVisualEditor 帧编辑器 === */
QGroupBox#frameHeaderGroup,
QGroupBox#frameLengthGroup,
QGroupBox#frameChecksumGroup,
QGroupBox#frameFieldGroup {
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QTableWidget#frameFieldTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #374151;
    border: 1px solid #e5e7eb;
    gridline-color: #e5e7eb;
    font-size: 12px;
    selection-background-color: #eff6ff;
}
QTableWidget#frameFieldTable::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #f9fafb;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#frameAddFieldBtn {
    background-color: #ffffff;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameAddFieldBtn:hover { background-color: #f3f4f6; border-color: #3b82f6; }
QPushButton#frameAddFieldBtn:pressed { background-color: #e5e7eb; }
QPushButton#frameAddFieldBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

QPushButton#frameRemoveFieldBtn {
    background-color: #ffffff;
    color: #ef4444;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameRemoveFieldBtn:hover { background-color: #f3f4f6; border-color: #ef4444; }
QPushButton#frameRemoveFieldBtn:pressed { background-color: #e5e7eb; }
QPushButton#frameRemoveFieldBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

/* === 背景设置弹出面板 === */
QWidget#bgSettingsPopup {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
}
QSlider#bgBlurSlider, QSlider#bgOpacitySlider {
    background: transparent;
    min-height: 20px;
}
QSlider#bgBlurSlider::groove:horizontal, QSlider#bgOpacitySlider::groove:horizontal {
    height: 4px;
    background: #d1d5db;
    border-radius: 2px;
}
QSlider#bgBlurSlider::handle:horizontal, QSlider#bgOpacitySlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #3b82f6;
    border-radius: 7px;
}
QSlider#bgBlurSlider::handle:horizontal:hover, QSlider#bgOpacitySlider::handle:horizontal:hover {
    background: #2563eb;
}

QSlider#bgBlurSlider::handle:horizontal:disabled, QSlider#bgOpacitySlider::handle:horizontal:disabled {
    background: #9ca3af;
}

QPushButton#bgSelectImageBtn {
    background-color: #f3f4f6;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgSelectImageBtn:hover { background-color: #e5e7eb; border-color: #3b82f6; }
QPushButton#bgSelectImageBtn:pressed { background-color: #d1d5db; }
QPushButton#bgSelectImageBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

QPushButton#bgResetBtn {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgResetBtn:hover { color: #ef4444; border-color: #ef4444; }
QPushButton#bgResetBtn:pressed { background-color: rgba(239,68,68,0.1); }
QPushButton#bgResetBtn:disabled { color: #d1d5db; border-color: #d1d5db; }

/* === QScrollBar 滚动条 - 现代极细圆角风格 === */

/* 垂直滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #d1d5db;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #d1d5db;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #9ca3af;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* === QToolTip 工具提示 === */
QToolTip {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* === QMenu 通用菜单样式 - 所有菜单统一风格 === */
QMenu {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
}
QMenu::item:disabled {
    color: #9ca3af;
}
QMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* === 工具栏下拉框 - 布局/主题/语言选择 === */
QComboBox#layoutCombo,
QComboBox#themeCombo,
QComboBox#langCombo {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    color: #1f2937;
    font-size: 12px;
    min-width: 80px;
}
QComboBox#layoutCombo:hover,
QComboBox#themeCombo:hover,
QComboBox#langCombo:hover {
    border-color: #3b82f6;
}
QComboBox#layoutCombo:disabled,
QComboBox#themeCombo:disabled,
QComboBox#langCombo:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* === PortWatcher 提示文字样式 === */
QLabel#driverInfoLbl {
    font-size: 11px;
    color: #9ca3af;
    padding: 4px 8px;
    background-color: transparent;
}

/* === 波形图 (ChartWidget) === */

/* 图表控制栏背景 */
QWidget#chartToolbar {
    background-color: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
}

/* 图表区域背景 - 与面板底色协调 */
QChartView {
    background-color: #ffffff;
}

/* 暂停按钮 - checked 时显示 accent 色表示"暂停中" */
QPushButton#chartPauseBtn {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
QPushButton#chartPauseBtn:hover { background-color: #e5e7eb; border-color: #3b82f6; }
QPushButton#chartPauseBtn:pressed { background-color: #d1d5db; }
QPushButton#chartPauseBtn:checked {
    background-color: #3b82f6;
    color: #ffffff;
    border-color: #3b82f6;
    font-weight: bold;
}
QPushButton#chartPauseBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

/* 清除按钮 */
QPushButton#chartClearBtn {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
QPushButton#chartClearBtn:hover { background-color: #e5e7eb; border-color: #ef4444; color: #ef4444; }
QPushButton#chartClearBtn:pressed { background-color: #d1d5db; }
QPushButton#chartClearBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

/* 窗口大小下拉框 */
QComboBox#chartWindowCombo {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 3px 8px;
    color: #1f2937;
    font-size: 12px;
}
QComboBox#chartWindowCombo:hover { border-color: #3b82f6; }
QComboBox#chartWindowCombo::drop-down { border: none; width: 20px; }

/* 状态标签 */
QLabel#chartStatusLabel {
    color: #9ca3af;
    font-size: 11px;
}

/* === QuickCommandBar 编辑对话框 === */
QDialog#quickCmdEditDlg {
    background-color: #ffffff;
}

QTableWidget#quickCmdEditTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    gridline-color: #e5e7eb;
    font-size: 12px;
    selection-background-color: #dbeafe;
    selection-color: #1d4ed8;
}
QTableWidget#quickCmdEditTable::item {
    padding: 4px 6px;
}

QPushButton#quickCmdAddRowBtn {
    background-color: #f3f4f6;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdAddRowBtn:hover { background-color: #e5e7eb; border-color: #3b82f6; }
QPushButton#quickCmdAddRowBtn:pressed { background-color: #d1d5db; }

QPushButton#quickCmdDelRowBtn {
    background-color: #f3f4f6;
    color: #ef4444;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdDelRowBtn:hover { background-color: #e5e7eb; border-color: #ef4444; }
QPushButton#quickCmdDelRowBtn:pressed { background-color: #d1d5db; }
