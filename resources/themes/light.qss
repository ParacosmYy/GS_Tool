/* EmbedDebug - 浅色主题 (明亮风格) */

/* 全局背景 */
QMainWindow {
    background-color: #ffffff;
}

/* 左侧导航树 */
QTreeView {
    background-color: #f3f4f6;
    color: #1f2937;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
}

QTreeView::item:hover {
    background-color: #e5e7eb;
}

/* 工具栏 */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #1f2937;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
}

QToolButton:pressed {
    background-color: #e5e7eb;
}

QToolButton:checked {
    background-color: #dbeafe;
    border: 1px solid #3b82f6;
    color: #1d4ed8;
}

/* 发送区域 */
QLineEdit {
    background-color: #ffffff;
    color: #166534;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
}

QPushButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #e5e7eb;
}

QPushButton:pressed {
    background-color: #d1d5db;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* 发送按钮 - 主题色高亮 */
QPushButton#sendButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #2563eb;
}

QPushButton#sendButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#sendButton:disabled { background-color: #d1d5db; color: #9ca3af; }

/* 应用定义按钮 - accent高亮 */
QPushButton#applyDefBtn {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#applyDefBtn:hover { background-color: #2563eb; }
QPushButton#applyDefBtn:pressed { background-color: #1d4ed8; }
QPushButton#applyDefBtn:disabled { background-color: #d1d5db; color: #9ca3af; }

/* 状态栏 */
QStatusBar {
    background-color: #f3f4f6;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    font-size: 12px;
}

/* 分隔器 */
QSplitter::handle {
    background-color: #e5e7eb;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar,
QWidget#quickCommandBar {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
}

/* 快捷指令按钮 - 统一样式 */
QPushButton#quickCmdEditBtn {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdEditBtn:hover { background-color: #e5e7eb; }
QPushButton#quickCmdEditBtn:pressed { background-color: #d1d5db; }
QPushButton#quickCmdEditBtn:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }

QPushButton#quickCmdAddBtn {
    background-color: #f3f4f6;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#quickCmdAddBtn:hover { background-color: #e5e7eb; color: #2563eb; }
QPushButton#quickCmdAddBtn:pressed { background-color: #d1d5db; }

/* 快捷指令按钮 - 动态命令按钮 */
QPushButton[quickCmdBtn="true"] {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton[quickCmdBtn="true"]:hover { background-color: #e5e7eb; border-color: #3b82f6; color: #1d4ed8; }
QPushButton[quickCmdBtn="true"]:pressed { background-color: #d1d5db; }

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #3b82f6;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    selection-background-color: #dbeafe;
}

/* SpinBox */
QSpinBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

/* CheckBox */
QCheckBox {
    color: #1f2937;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border: 1px solid #3b82f6;
}

/* 配置面板标签 */
QLabel {
    color: #374151;
    font-size: 13px;
}

QGroupBox {
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #2563eb; }
QPushButton#otaStartBtn:pressed { background-color: #1d4ed8; }
QPushButton#otaStartBtn:disabled { background-color: #d1d5db; color: #9ca3af; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #ef4444;
    border: 1px solid #ef4444;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(239,68,68,0.1); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(239,68,68,0.2); }
QPushButton#otaCancelBtn:disabled { color: #d1d5db; border-color: #d1d5db; }

QProgressBar#otaProgress {
    background-color: #f3f4f6;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #374151;
}
QProgressBar#otaProgress::chunk {
    background-color: #3b82f6;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #ffffff;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #f9fafb;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #ef4444; border-color: #ef4444; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #22c55e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #16a34a; }
QPushButton#connectBtn[state="connected"] {
    background-color: #ef4444;
    color: #ffffff;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #dc2626; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #22c55e; }
QLabel#connStatus[state="disconnected"] { color: #dc2626; }
QLabel#connStatus[state="connecting"] { color: #f59e0b; }
QLabel#connStatus[state="error"] { color: #dc2626; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #22c55e; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #22c55e; font-size: 11px; }
QLabel#txTotalLabel { color: #ef4444; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #ef4444; font-size: 11px; }
QLabel#elapsedLabel { color: #374151; font-size: 13px; font-family: monospace; }

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #f3f4f6; }

QLineEdit#searchBarInput {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #3b82f6;
}
QLineEdit#searchBarInput:focus { border: 1px solid #3b82f6; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #ffffff;
    color: #1f2937;
    border: 2px solid #ef4444;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #1f2937;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #3b82f6; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #f3f4f6; border: 1px solid #d1d5db; border-radius: 2px;
}

QLabel#searchBarResult { color: #6b7280; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #ef4444; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #e5e7eb; color: #374151;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #3b82f6; color: #ffffff; }
QPushButton#searchBarCloseBtn:pressed { background: #2563eb; color: #ffffff; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #ef4444; }

/* === ProtocolView 协议解析面板 === */
QWidget#protocolToolbar {
    background-color: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
}
QLabel#protocolStatusLabel {
    color: #6b7280;
    font-size: 12px;
}
QPushButton#protocolClearBtn,
QPushButton#protocolExportBtn {
    background-color: transparent;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#protocolClearBtn:hover,
QPushButton#protocolExportBtn:hover { background-color: #f3f4f6; border-color: #3b82f6; color: #3b82f6; }
QPushButton#protocolClearBtn:pressed,
QPushButton#protocolExportBtn:pressed { background-color: #e5e7eb; }

QTableView#protocolTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #374151;
    border: none;
    gridline-color: #e5e7eb;
    font-size: 12px;
    selection-background-color: #eff6ff;
    selection-color: #3b82f6;
}
QTableView#protocolTable::item {
    padding: 4px 8px;
}

/* === FrameVisualEditor 帧编辑器 === */
QGroupBox#frameHeaderGroup,
QGroupBox#frameLengthGroup,
QGroupBox#frameChecksumGroup,
QGroupBox#frameFieldGroup {
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QTableWidget#frameFieldTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #374151;
    border: 1px solid #e5e7eb;
    gridline-color: #e5e7eb;
    font-size: 12px;
    selection-background-color: #eff6ff;
}
QTableWidget#frameFieldTable::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #f9fafb;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#frameAddFieldBtn {
    background-color: #ffffff;
    color: #3b82f6;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameAddFieldBtn:hover { background-color: #f3f4f6; border-color: #3b82f6; }
QPushButton#frameAddFieldBtn:pressed { background-color: #e5e7eb; }

QPushButton#frameRemoveFieldBtn {
    background-color: #ffffff;
    color: #ef4444;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameRemoveFieldBtn:hover { background-color: #f3f4f6; border-color: #ef4444; }
QPushButton#frameRemoveFieldBtn:pressed { background-color: #e5e7eb; }
