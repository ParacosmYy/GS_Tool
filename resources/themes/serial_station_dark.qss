/* EmbedDebug Serial Station — VOFA+ 精致工业风深色主题（参考源）
 *
 * 本文件是 ThemeManager 的外部编辑路径：存在时 ThemeManager.load_qss 优先读取；
 * 缺失回退到 qss_builder.build_qss()。从 build_qss() 自动生成。
 */

/* === Global === */
QWidget {
    background-color: #0d1118;
    color: #d7def3;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}
QWidget:disabled {
    color: #5f6f86;
}
/* 全局 tooltip：深底圆角，对齐应用主题。 */
QToolTip {
    background-color: #1b2634;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

/* === Window & Root === */
QMainWindow,
QMainWindow#embeddebugPySerialStationWindow {
    background-color: #0d1118;
}
QWidget#serialStationPyRoot {
    background-color: #101218;
}
QLabel#serialStationPyTitle {
    color: #d7def3;
    font-size: 18px;
    font-weight: 600;
    padding: 6px 0px;
}

/* === Labels === */
QLabel {
    background-color: transparent;
    color: #b7c0d8;
}
QLabel#serialStationLogStatsLabel {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 0 8px;
}

/* === TopBar (Brand + Status + Profile) === */
QFrame#serialStationTopBar {
    background-color: #131a25;
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #131a25,
        stop:1 #10141d
    );
    border: 1px solid #2a3647;
    border-radius: 12px;
}
/* 品牌徽标 chip：强调青软底 + 图标。 */
QFrame#serialStationBrandChip {
    background-color: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.40);
    border-radius: 6px;
}
QLabel#serialStationBrandIcon {
    background-color: transparent;
    border: none;
}
QLabel#serialStationBrandName {
    background-color: transparent;
    color: #d7def3;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QLabel#serialStationBrandTagline {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
}

/* === Glass Cards (EK-OmniProbe surface-card, dark industrial) === */
QFrame#serialStationCard {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(0, 0, 0, 0.30);
    border-radius: 16px;
    /* 3-stop 顶部光带：压缩到顶部 ~18%，模拟玻璃 inner highlight + 反光带。 */
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.12),
        stop:0.18 rgba(255, 255, 255, 0.04),
        stop:0.5 rgba(255, 255, 255, 0.00)
    );
    padding: 12px;
}
QFrame#serialStationCard:hover {
    border: 1px solid rgba(34, 211, 238, 0.55);
    background-color: #1b2634;
}
/* 卡片标题行：底部柔和分隔线（半透明 + hover 联动转强调青）。 */
QWidget#serialStationCardHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(39, 49, 63, 0.6);
    padding-bottom: 6px;
}
QFrame#serialStationCard:hover QWidget#serialStationCardHeader {
    border-bottom-color: rgba(34, 211, 238, 0.35);
}
QLabel#serialStationCardTitle {
    background-color: transparent;
    color: #d7def3;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
}
QLabel#serialStationCardIcon {
    background-color: transparent;
    border: none;
}
/* 可折叠面板 */
QWidget#serialStationCollapsiblePanel {
    background-color: transparent;
    border: none;
}
/* 连接卡内的小分组标题（Port/Serial/Connect/Endpoints）：弱文本色小字号。 */
QLabel#serialStationCardGroupLabel {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding-top: 6px;
    padding-bottom: 4px;
}
/* 日志卡主体容器：保持透明，让 QPlainTextEdit 自身样式生效。 */
QVBoxLayout#serialStationCardBody,
QVBoxLayout#serialStationLogCardBody {
    background-color: transparent;
    border: none;
}

/* === Collapsible Card (connection sidebar low-freq groups) === */
QFrame#serialStationCollapsibleCard {
    background-color: #0f141d;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QWidget#serialStationCollapsibleHeader {
    background-color: transparent;
    border: none;
    padding: 4px 6px;
}
QWidget#serialStationCollapsibleHeader:hover {
    background-color: #1b2634;
    border-radius: 4px;
}
QLabel#serialStationCollapsibleArrow {
    background-color: transparent;
    border: none;
}
QLabel#serialStationCollapsibleTitle {
    background-color: transparent;
    color: #b7c0d8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}
QWidget#serialStationCollapsibleBody {
    background-color: transparent;
    border: none;
}

/* === Three-Zone Shell Containers === */
QWidget#serialStationLeftZone,
QWidget#serialStationCenterZone,
QWidget#serialStationRightZone {
    background-color: transparent;
    border: none;
}
/* 串口配置面板容器（连接侧栏包装层） */
QWidget#serialStationSerialPanel {
    background-color: transparent;
    border: none;
}

/* === Splitter Handles === */
QSplitter#serialStationMainSplitter::handle {
    background-color: #27313f;
}
QSplitter#serialStationMainSplitter::handle:hover {
    background-color: rgba(34, 211, 238, 0.35);
}
QSplitter#serialStationMainSplitter::handle:horizontal {
    width: 2px;
    margin: 8px 0;
}
QSplitter#serialStationMainSplitter::handle:vertical {
    height: 2px;
    margin: 0 8px;
}

/* === Command Palette (VS Code Ctrl+P style) === */
QWidget#serialStationCommandPalette {
    background-color: rgba(13, 17, 24, 200);
}
QFrame#serialStationCommandPaletteCard {
    background-color: #151b24;
    border: 1px solid #334155;
    border-radius: 12px;
    /* 顶部高光渐变：与主卡片一致的玻璃反光。 */
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.05),
        stop:1 rgba(255, 255, 255, 0.00)
    );
}
QLineEdit#serialStationCommandPaletteEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: none;
    border-bottom: 1px solid #27313f;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 8px 16px;
    font-size: 14px;
    selection-background-color: #2563eb;
    selection-color: #f8fafc;
}
QLineEdit#serialStationCommandPaletteEdit:focus {
    border-bottom-color: #22d3ee;
}
QListWidget#serialStationCommandPaletteList {
    background-color: transparent;
    color: #d7def3;
    border: none;
    padding: 6px;
    outline: none;
}
QListWidget#serialStationCommandPaletteList::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget#serialStationCommandPaletteList::item:selected {
    background-color: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
}
QListWidget#serialStationCommandPaletteList::item:hover {
    background-color: #1b2634;
}
QLabel#serialStationCommandPaletteHint {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
    padding: 6px 8px;
    border-top: 1px solid #27313f;
}

/* === Waveform Cursor HUD & Legend === */
QLabel#serialStationWaveformCursorHud {
    background-color: #151b24;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
QWidget#serialStationWaveformLegend {
    background-color: transparent;
    border: none;
}
QLabel#serialStationWaveformLegendChip {
    background-color: transparent;
    border: none;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 4px 6px;
}
/* 波形游标线（pyqtgraph InfiniteLine）：QSS 对其有限，颜色由运行时 pen 设置；
   此处保留契约占位满足覆盖率守护，objectName 用于游标可发现性与测试。 */
QGraphicsLineItem#serialStationWaveformCursorX,
QGraphicsLineItem#serialStationWaveformCursorY {
    /* no-op: color set via pg.mkPen at runtime */
}

/* === Control Widgets (LED / Slider / Button / Gauge / Value) === */
/* 状态 LED：自绘圆形，QSS 仅控制容器背景。 */
QWidget#serialStationStatusLed {
    background-color: transparent;
}
/* 命令滑块容器与子控件 */
QWidget#serialStationCommandSlider {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QLabel#serialStationSliderLabel {
    color: #b7c0d8;
    font-size: 12px;
}
QLabel#serialStationSliderValue {
    color: #22d3ee;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
QSlider#serialStationSliderTrack::groove:horizontal {
    background: #0f141d;
    height: 6px;
    border-radius: 3px;
}
QSlider#serialStationSliderTrack::sub-page:horizontal {
    background: #22d3ee;
    border-radius: 3px;
}
QSlider#serialStationSliderTrack::handle:horizontal {
    background: #d7def3;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
/* 可配置按钮 */
QPushButton#serialStationConfigurableButton {
    background-color: #1b2634;
    color: #d7def3;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#serialStationConfigurableButton:hover {
    background-color: rgba(34, 211, 238, 0.12);
    border-color: #22d3ee;
}
QPushButton#serialStationConfigurableButton:pressed {
    background-color: #203044;
}
/* 仪表盘：自绘，QSS 仅控制背景。 */
QWidget#serialStationGauge {
    background-color: transparent;
}
/* 数值显示 */
QWidget#serialStationValueDisplay {
    background-color: transparent;
}
QLabel#serialStationValueLabel {
    color: #9aa7bd;
    font-size: 11px;
}
QLabel#serialStationValueNumber {
    color: #d7def3;
    font-weight: 600;
}
QLabel#serialStationValueTrend {
    background-color: transparent;
}
/* === Dashboard（画布/控件库/标签页） === */
QFrame#serialStationDashboardCanvas {
    background-color: #101218;
    border: 1px dashed #27313f;
    border-radius: 8px;
}
QTabWidget#serialStationDashboardTabs::pane {
    background-color: #101218;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QTabWidget#serialStationDashboardTabs::tab-bar {
    alignment: left;
}
QTabBar#serialStationDashboardTabs {
    background: transparent;
}
QFrame#serialStationWidgetPalette {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QLabel#serialStationPaletteTitle {
    color: #d7def3;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#serialStationPaletteButton {
    background-color: #0f141d;
    color: #b7c0d8;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 4px 8px;
    text-align: left;
}
QPushButton#serialStationPaletteButton:hover {
    background-color: #1b2634;
    border-color: rgba(34, 211, 238, 0.35);
    color: #d7def3;
}

/* === App Navigation Rail === */
QFrame#serialStationNavRail {
    background-color: #101218;
    border-right: 1px solid #27313f;
}
/* 品牌徽标 ED：强调青渐变方块 + 反白字（仿 EK-OmniProbe logo chip）。 */
QLabel#serialStationNavBrand {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #67e8f9, stop:1 #0891b2
    );
    color: #f8fafc;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
/* 导航图标按钮：方形、无边框、hover 微背景、激活态强调青软底 + 左指示条。 */
QPushButton[objectName^="serialStationNav"] {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 8px;
    margin: 0 6px;
    min-width: 40px;
    min-height: 40px;
}
QPushButton[objectName^="serialStationNav"]:hover {
    background-color: #1b2634;
}
QPushButton[objectName^="serialStationNav"]:checked {
    background-color: rgba(34, 211, 238, 0.12);
    border-left: 3px solid #22d3ee;
}

/* === OTA Panel === */
QWidget#serialStationOtaPanel {
    background-color: #101218;
}
QLabel#serialStationOtaFieldLabel {
    color: #b7c0d8;
    font-size: 12px;
    font-weight: 600;
}
QComboBox#serialStationOtaProtocolCombo {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}
QFrame#serialStationOtaFileEdit {
    background-color: #0f141d;
    border: 1px solid #334155;
    border-radius: 6px;
    min-height: 28px;
}
QLabel#serialStationOtaFileLabel {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
QProgressBar#serialStationOtaProgress {
    background-color: #0f141d;
    border: 1px solid #27313f;
    border-radius: 6px;
    text-align: center;
    color: #d7def3;
    min-height: 28px;
}
QProgressBar#serialStationOtaProgress::chunk {
    background-color: #22d3ee;
    border-radius: 6px;
}
QPlainTextEdit#serialStationOtaLog {
    background-color: #0d1118;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 5px 8px;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
QLabel#serialStationOtaStatusLabel {
    color: #9aa7bd;
    font-size: 12px;
    padding: 0 8px;
}
QPushButton#serialStationOtaBrowseButton {
    background-color: #151b24;
    color: #b7c0d8;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#serialStationOtaBrowseButton:hover {
    background-color: #1b2634;
    border-color: rgba(34, 211, 238, 0.35);
}
QPushButton#serialStationOtaStartButton {
    background-color: #22d3ee;
    color: #0d1118;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#serialStationOtaStartButton:hover {
    background-color: #67e8f9;
}
QPushButton#serialStationOtaStartButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
}

/* === Domain Panels (RTT / CAN / BLE / Automation / Settings) === */
/* 面板根：统一深色应用底。 */
QWidget#serialStationRttPanel,
QWidget#serialStationCanPanel,
QWidget#serialStationBlePanel,
QWidget#serialStationAutomationPanel,
QWidget#serialStationSettingsPanel {
    background-color: #101218;
}
/* 字段标签（"通道/设备/ID/数据/特征/主题"等行内标签）。 */
QLabel#serialStationRttFieldLabel,
QLabel#serialStationCanFieldLabel,
QLabel#serialStationBleFieldLabel,
QLabel#serialStationSettingsFieldLabel {
    color: #b7c0d8;
    font-size: 12px;
    font-weight: 600;
}
/* 状态标签。 */
QLabel#serialStationRttStatusLabel,
QLabel#serialStationCanStatsLabel,
QLabel#serialStationAutomationStatusLabel,
QLabel#serialStationSettingsThemeStatusLabel {
    color: #9aa7bd;
    font-size: 12px;
    padding: 0 8px;
}
/* 日志/文本视图（终端风：深底 + 等宽）。 */
QPlainTextEdit#serialStationRttTextView,
QPlainTextEdit#serialStationBleLog,
QPlainTextEdit#serialStationAutomationLog {
    background-color: #0d1118;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 5px 8px;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
/* 主操作按钮（启停/连接/发送/应用：强调青）。 */
QPushButton#serialStationRttStartButton,
QPushButton#serialStationCanSendButton,
QPushButton#serialStationBleConnectButton,
QPushButton#serialStationAutomationRunButton,
QPushButton#serialStationSettingsApplyButton {
    background-color: #22d3ee;
    color: #0d1118;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton#serialStationRttStartButton:hover,
QPushButton#serialStationCanSendButton:hover,
QPushButton#serialStationBleConnectButton:hover,
QPushButton#serialStationAutomationRunButton:hover,
QPushButton#serialStationSettingsApplyButton:hover {
    background-color: #67e8f9;
}
/* 次要按钮（清空/扫描/演示/读/写/订阅/手动触发/刷新）。 */
QPushButton#serialStationRttClearButton,
QPushButton#serialStationCanClearButton,
QPushButton#serialStationCanDemoButton,
QPushButton#serialStationBleScanButton,
QPushButton#serialStationBleReadButton,
QPushButton#serialStationBleWriteButton,
QPushButton#serialStationBleNotifyButton,
QPushButton#serialStationAutomationFireButton,
QPushButton#serialStationAutomationRefreshButton {
    background-color: #151b24;
    color: #b7c0d8;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#serialStationRttClearButton:hover,
QPushButton#serialStationCanClearButton:hover,
QPushButton#serialStationCanDemoButton:hover,
QPushButton#serialStationBleScanButton:hover,
QPushButton#serialStationBleReadButton:hover,
QPushButton#serialStationBleWriteButton:hover,
QPushButton#serialStationBleNotifyButton:hover,
QPushButton#serialStationAutomationFireButton:hover,
QPushButton#serialStationAutomationRefreshButton:hover {
    background-color: #1b2634;
    border-color: rgba(34, 211, 238, 0.35);
}
/* 输入框（ID/数据/payload/特征 UUID/主题 combo/通道 combo/设备 combo）。 */
QLineEdit#serialStationCanIdEdit,
QLineEdit#serialStationCanDataEdit,
QLineEdit#serialStationBleCharUuidEdit,
QLineEdit#serialStationBlePayloadEdit,
QComboBox#serialStationRttChannelCombo,
QComboBox#serialStationBleDeviceCombo,
QComboBox#serialStationSettingsThemeCombo {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}
/* CAN 复选框。 */
QCheckBox#serialStationCanExtCheckBox {
    color: #b7c0d8;
    spacing: 6px;
}
/* 表格 / 树（CAN 帧表、Automation 规则表、Settings 快捷键表、BLE GATT 树）。 */
QTableWidget#serialStationCanFrameTable,
QTableWidget#serialStationAutomationRuleTable,
QTableWidget#serialStationSettingsShortcutsTable,
QTreeWidget#serialStationBleGattTree {
    background-color: #151b24;
    color: #d7def3;
    border: 1px solid #27313f;
    border-radius: 6px;
    gridline-color: #27313f;
    font-size: 12px;
}
QTableWidget#serialStationCanFrameTable::item,
QTableWidget#serialStationAutomationRuleTable::item,
QTableWidget#serialStationSettingsShortcutsTable::item,
QTreeWidget#serialStationBleGattTree::item {
    padding: 4px 6px;
}
QTableWidget#serialStationCanFrameTable::item:selected,
QTableWidget#serialStationAutomationRuleTable::item:selected,
QTableWidget#serialStationSettingsShortcutsTable::item:selected,
QTreeWidget#serialStationBleGattTree::item:selected {
    background-color: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
}
QHeaderView::section {
    background-color: #1b2634;
    color: #b7c0d8;
    border: none;
    border-bottom: 1px solid #27313f;
    padding: 4px 6px;
    font-weight: 600;
}
/* 设置页 Tab。 */
QTabWidget#serialStationSettingsTabWidget::pane {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QTabBar::tab {
    background-color: #0f141d;
    color: #b7c0d8;
    padding: 6px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
}
/* 关于页标签。 */
QLabel#serialStationSettingsAppNameLabel {
    color: #d7def3;
    font-size: 18px;
    font-weight: 700;
}
QLabel#serialStationSettingsVersionLabel,
QLabel#serialStationSettingsRemoteLabel {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}

/* === Buttons === */
QPushButton {
    background-color: #151b24;
    color: #d7def3;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #1b2634;
    border-color: #334155;
}
QPushButton:pressed {
    background-color: #203044;
    border-color: #0891b2;
}
QPushButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
/* 连接类主按钮 — 强调青底 */
QPushButton#serialStationConnectButton,
QPushButton#serialStationConnectSerialButton,
QPushButton#serialStationConnectTcpButton,
QPushButton#serialStationConnectUdpButton {
    background-color: #22d3ee;
    color: #0d1118;
    border: 0px;
    font-weight: 600;
}
QPushButton#serialStationConnectButton:hover,
QPushButton#serialStationConnectSerialButton:hover,
QPushButton#serialStationConnectTcpButton:hover,
QPushButton#serialStationConnectUdpButton:hover {
    background-color: #67e8f9;
}
QPushButton#serialStationConnectButton:pressed,
QPushButton#serialStationConnectSerialButton:pressed,
QPushButton#serialStationConnectTcpButton:pressed,
QPushButton#serialStationConnectUdpButton:pressed {
    background-color: #0891b2;
}
QPushButton#serialStationConnectButton:disabled,
QPushButton#serialStationConnectSerialButton:disabled,
QPushButton#serialStationConnectTcpButton:disabled,
QPushButton#serialStationConnectUdpButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
}
/* 断开按钮 — 危险红 */
QPushButton#serialStationDisconnectButton {
    background-color: rgba(239, 68, 68, 0.10);
    color: #ef4444;
    border: 1px solid #ef4444;
}
QPushButton#serialStationDisconnectButton:hover {
    background-color: #ef4444;
    color: #f8fafc;
}
QPushButton#serialStationDisconnectButton:pressed {
    background-color: #f87171;
}
/* 次要工具按钮 */
QPushButton#serialStationRefreshPortsButton,
QPushButton#serialStationExportLogButton,
QPushButton#serialStationReplayLogButton,
QPushButton#serialStationSaveProfileButton,
QPushButton#serialStationLoadProfileButton,
QPushButton#serialStationClearButton,
QPushButton#serialStationInjectButton,
QPushButton#serialStationSendButton {
    background-color: #151b24;
    color: #b7c0d8;
}
QPushButton#serialStationRefreshPortsButton:hover,
QPushButton#serialStationExportLogButton:hover,
QPushButton#serialStationReplayLogButton:hover,
QPushButton#serialStationSaveProfileButton:hover,
QPushButton#serialStationLoadProfileButton:hover,
QPushButton#serialStationClearButton:hover,
QPushButton#serialStationInjectButton:hover,
QPushButton#serialStationSendButton:hover {
    background-color: #1b2634;
    color: #d7def3;
    border-color: rgba(34, 211, 238, 0.35);
}
/* 发送/注入 — 终端 TX 蓝 */
QPushButton#serialStationSendButton,
QPushButton#serialStationInjectButton {
    color: #38bdf8;
    border-color: #38bdf8;
}
QPushButton#serialStationSendButton:hover,
QPushButton#serialStationInjectButton:hover {
    background-color: #38bdf8;
    color: #f8fafc;
}

/* === Line Edits === */
QLineEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: rgba(34, 211, 238, 0.12);
    selection-color: #d7def3;
}
QLineEdit:hover {
    border-color: rgba(34, 211, 238, 0.35);
}
QLineEdit:focus {
    border: 1px solid #22d3ee;
    background-color: #111827;
}
QLineEdit:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
QLineEdit::placeholder {
    color: rgba(154, 167, 189, 0.55);
}
QLineEdit#serialStationSendEdit,
QLineEdit#serialStationInjectEdit,
QLineEdit#serialStationLogSearchEdit,
QLineEdit#serialStationLogPathEdit,
QLineEdit#serialStationProfilePathEdit,
QLineEdit#serialStationProfileNameEdit,
QLineEdit#serialStationTcpHostEdit,
QLineEdit#serialStationTcpPortEdit,
QLineEdit#serialStationUdpHostEdit,
QLineEdit#serialStationUdpPortEdit {
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}

/* === ComboBoxes === */
QComboBox {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
    selection-background-color: #203044;
}
QComboBox:hover {
    border-color: rgba(34, 211, 238, 0.35);
}
QComboBox:focus {
    border: 1px solid #22d3ee;
}
QComboBox:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #151b24;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(34, 211, 238, 0.12);
    selection-color: #22d3ee;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #1b2634;
}
QComboBox#serialStationProtocolCombo,
QComboBox#serialStationPortCombo,
QComboBox#serialStationBaudCombo,
QComboBox#serialStationDataBitsCombo,
QComboBox#serialStationParityCombo,
QComboBox#serialStationStopBitsCombo,
QComboBox#serialStationFlowControlCombo,
QComboBox#serialStationCommandHistoryCombo,
QComboBox#serialStationLogFilterCombo {
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}

/* === Log View (Terminal) === */
QPlainTextEdit#serialStationLogView {
    background-color: #0d1118;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 8px;
    padding: 6px 12px;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    selection-background-color: rgba(34, 211, 238, 0.12);
    selection-color: #d7def3;
}
QPlainTextEdit#serialStationLogView:focus {
    border-color: rgba(34, 211, 238, 0.35);
}

/* === Waveform Preview === */
QWidget#serialStationWaveformPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
/* pyqtgraph PlotWidget：QSS 仅控制背景，绘图区背景在运行时通过
   setBackground 设置，此处保证控件框与面板一致。 */
QWidget#serialStationWaveformPlot,
QGraphicsView#serialStationWaveformPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationWaveformStatusLabel {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 6px 8px;
}
/* 多通道图例（对齐 VOFA+ 通道色块） */
QWidget#serialStationWaveformLegend {
    background-color: transparent;
    border-top: 1px solid #27313f;
}
QLabel#serialStationWaveformLegendChip {
    background-color: transparent;
    font-size: 12px;
}
/* 游标读数 HUD */
QLabel#serialStationWaveformCursorHud {
    background-color: transparent;
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 4px 8px;
}
/* 富游标 objectName 契约：pyqtgraph InfiniteLine 不可由 QSS 设置样式，
   样式通过运行时 pen 参数设置（强调青/警告黄），此处保留契约占位。 */
QObject#serialStationWaveformCursorX,
QObject#serialStationWaveformCursorY {
    /* no-op */
}
/* === 李萨如（X-Y）面板 === */
QWidget#serialStationLissajousPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QWidget#serialStationLissajousPlot,
QGraphicsView#serialStationLissajousPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationLissajousStatus {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 4px 8px;
}
/* === 条形图面板 === */
QWidget#serialStationBarChartPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QWidget#serialStationBarChartPlot,
QGraphicsView#serialStationBarChartPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationBarChartStatus {
    color: #9aa7bd;
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    padding: 4px 8px;
}

/* === Status & Profile Labels === */
QLabel#serialStationStatusLabel {
    color: #f59e0b;
    padding: 4px 8px;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 12px;
    background-color: rgba(245, 158, 11, 0.08);
    font-size: 12px;
    font-weight: 600;
}
QLabel#serialStationProfileLabel {
    color: #9aa7bd;
    font-size: 12px;
    padding: 4px 8px;
}

/* === Scrollbars (8px capsule, soft hover) === */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 1px;
}
QScrollBar::handle:vertical {
    background: rgba(51, 65, 85, 0.55);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(71, 85, 105, 0.85);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 1px;
}
QScrollBar::handle:horizontal {
    background: rgba(51, 65, 85, 0.55);
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(71, 85, 105, 0.85);
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

/* === PlainTextEdit Fallback === */
QPlainTextEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
}

/* === Shortcut objectName contract === */
/* QShortcut 无可视样式，objectName 仅用于测试与可发现性，此处保留契约占位。 */
QObject#serialStationSendShortcut,
QObject#serialStationClearShortcut,
QObject#serialStationRefreshPortsShortcut,
QObject#serialStationCommandPaletteShortcut {
    /* no-op */
}
