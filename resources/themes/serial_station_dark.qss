/* EmbedDebug Serial Station — VOFA+ 精致工业风深色主题（参考源）
 *
 * 本文件是 ThemeManager 的外部编辑路径：当 resources/themes/serial_station_dark.qss
 * 存在时，ThemeManager.load_qss 会优先读取本文件；缺失或读取失败时回退到
 * python/embeddebug/serial_station/ui/theme/qss_builder.py 的程序化生成。
 *
 * 颜色与尺寸真相源在 palette.py / tokens.py；本文件用于设计期手改 QSS 调试。
 * 如需同步本文件与程序化生成器，删除本文件后由 ThemeManager 自动回退到生成器，
 * 再用 `python -c "from embeddebug.serial_station.ui.theme.qss_builder import build_qss as b; print(b())"`
 * 重新生成。
 *
 * 本文件从 build_qss() 自动生成。
 */

/* === Global === */
QWidget {
    background-color: #0d1118;
    color: #d7def3;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}
QWidget:disabled {
    color: #5f6f86;
}

/* === Window & Root === */
QMainWindow,
QMainWindow#embeddebugPySerialStationWindow {
    background-color: #0d1118;
}
QWidget#serialStationPyRoot {
    background-color: #101218;
}
QLabel#serialStationPyTitle {
    color: #d7def3;
    font-size: 18px;
    font-weight: 600;
    padding: 6px 0px;
}

/* === Labels === */
QLabel {
    background-color: transparent;
    color: #b7c0d8;
}
QLabel#serialStationLogStatsLabel {
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 0 8px;
}

/* === TopBar (Brand + Status + Profile) === */
QFrame#serialStationTopBar {
    background-color: #131a25;
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #131a25,
        stop:1 #10141d
    );
    border: 1px solid #2a3647;
    border-radius: 12px;
}
/* 品牌徽标 chip：强调青软底 + 图标。 */
QFrame#serialStationBrandChip {
    background-color: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.40);
    border-radius: 6px;
}
QLabel#serialStationBrandIcon {
    background-color: transparent;
    border: none;
}
QLabel#serialStationBrandName {
    background-color: transparent;
    color: #d7def3;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QLabel#serialStationBrandTagline {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
}

/* === Glass Cards (EK-OmniProbe surface-card, dark industrial) === */
QFrame#serialStationCard {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 16px;
    /* 顶部高光渐变：模拟玻璃 inner highlight（QSS 无 blur 的近似手段）。 */
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.05),
        stop:1 rgba(255, 255, 255, 0.00)
    );
    padding: 12px;
}
QFrame#serialStationCard:hover {
    border-color: rgba(34, 211, 238, 0.35);
    background-color: #1b2634;
}
/* 卡片标题行：底部细分隔线，拉开标题与内容。 */
QWidget#serialStationCardHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #27313f;
    padding-bottom: 6px;
}
QLabel#serialStationCardTitle {
    background-color: transparent;
    color: #d7def3;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
}
QLabel#serialStationCardIcon {
    background-color: transparent;
    border: none;
}
/* 连接卡内的小分组标题（Port/Serial/Connect/Endpoints）：弱文本色小字号。 */
QLabel#serialStationCardGroupLabel {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding-top: 6px;
    padding-bottom: 4px;
}
/* 日志卡主体容器：保持透明，让 QPlainTextEdit 自身样式生效。 */
QVBoxLayout#serialStationCardBody,
QVBoxLayout#serialStationLogCardBody {
    background-color: transparent;
    border: none;
}

/* === Three-Zone Shell Containers === */
QWidget#serialStationLeftZone,
QWidget#serialStationCenterZone,
QWidget#serialStationRightZone {
    background-color: transparent;
    border: none;
}
/* 串口配置面板容器（连接侧栏包装层） */
QWidget#serialStationSerialPanel {
    background-color: transparent;
    border: none;
}

/* === Splitter Handles === */
QSplitter#serialStationMainSplitter::handle {
    background-color: #27313f;
}
QSplitter#serialStationMainSplitter::handle:hover {
    background-color: rgba(34, 211, 238, 0.35);
}
QSplitter#serialStationMainSplitter::handle:horizontal {
    width: 2px;
    margin: 8px 0;
}
QSplitter#serialStationMainSplitter::handle:vertical {
    height: 2px;
    margin: 0 8px;
}

/* === Command Palette (VS Code Ctrl+P style) === */
QWidget#serialStationCommandPalette {
    background-color: rgba(13, 17, 24, 200);
}
QFrame#serialStationCommandPaletteCard {
    background-color: #151b24;
    border: 1px solid #334155;
    border-radius: 12px;
    /* 顶部高光渐变：与主卡片一致的玻璃反光。 */
    background-image: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.05),
        stop:1 rgba(255, 255, 255, 0.00)
    );
}
QLineEdit#serialStationCommandPaletteEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: none;
    border-bottom: 1px solid #27313f;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 8px 16px;
    font-size: 14px;
    selection-background-color: #2563eb;
    selection-color: #f8fafc;
}
QLineEdit#serialStationCommandPaletteEdit:focus {
    border-bottom-color: #22d3ee;
}
QListWidget#serialStationCommandPaletteList {
    background-color: transparent;
    color: #d7def3;
    border: none;
    padding: 6px;
    outline: none;
}
QListWidget#serialStationCommandPaletteList::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget#serialStationCommandPaletteList::item:selected {
    background-color: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
}
QListWidget#serialStationCommandPaletteList::item:hover {
    background-color: #1b2634;
}
QLabel#serialStationCommandPaletteHint {
    background-color: transparent;
    color: #9aa7bd;
    font-size: 11px;
    padding: 6px 8px;
    border-top: 1px solid #27313f;
}

/* === Waveform Cursor HUD & Legend === */
QLabel#serialStationWaveformCursorHud {
    background-color: #151b24;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}
QWidget#serialStationWaveformLegend {
    background-color: transparent;
    border: none;
}
QLabel#serialStationWaveformLegendChip {
    background-color: transparent;
    border: none;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 4px 6px;
}
/* 波形游标线（pyqtgraph InfiniteLine）：QSS 对其有限，颜色由运行时 pen 设置；
   此处保留契约占位满足覆盖率守护，objectName 用于游标可发现性与测试。 */
QGraphicsLineItem#serialStationWaveformCursorX,
QGraphicsLineItem#serialStationWaveformCursorY {
    /* no-op: color set via pg.mkPen at runtime */
}

/* === Control Widgets (LED / Slider / Button / Gauge / Value) === */
/* 状态 LED：自绘圆形，QSS 仅控制容器背景。 */
QWidget#serialStationStatusLed {
    background-color: transparent;
}
/* 命令滑块容器与子控件 */
QWidget#serialStationCommandSlider {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QLabel#serialStationSliderLabel {
    color: #b7c0d8;
    font-size: 12px;
}
QLabel#serialStationSliderValue {
    color: #22d3ee;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}
QSlider#serialStationSliderTrack::groove:horizontal {
    background: #0f141d;
    height: 6px;
    border-radius: 3px;
}
QSlider#serialStationSliderTrack::sub-page:horizontal {
    background: #22d3ee;
    border-radius: 3px;
}
QSlider#serialStationSliderTrack::handle:horizontal {
    background: #d7def3;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
/* 可配置按钮 */
QPushButton#serialStationConfigurableButton {
    background-color: #1b2634;
    color: #d7def3;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#serialStationConfigurableButton:hover {
    background-color: rgba(34, 211, 238, 0.12);
    border-color: #22d3ee;
}
QPushButton#serialStationConfigurableButton:pressed {
    background-color: #203044;
}
/* 仪表盘：自绘，QSS 仅控制背景。 */
QWidget#serialStationGauge {
    background-color: transparent;
}
/* 数值显示 */
QWidget#serialStationValueDisplay {
    background-color: transparent;
}
QLabel#serialStationValueLabel {
    color: #9aa7bd;
    font-size: 11px;
}
QLabel#serialStationValueNumber {
    color: #d7def3;
    font-weight: 600;
}
QLabel#serialStationValueTrend {
    background-color: transparent;
}
/* === Dashboard（画布/控件库/标签页） === */
QFrame#serialStationDashboardCanvas {
    background-color: #101218;
    border: 1px dashed #27313f;
    border-radius: 8px;
}
QTabWidget#serialStationDashboardTabs::pane {
    background-color: #101218;
    border: 1px solid #27313f;
    border-radius: 6px;
}
QTabWidget#serialStationDashboardTabs::tab-bar {
    alignment: left;
}
QTabBar#serialStationDashboardTabs {
    background: transparent;
}
QFrame#serialStationWidgetPalette {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QLabel#serialStationPaletteTitle {
    color: #d7def3;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#serialStationPaletteButton {
    background-color: #0f141d;
    color: #b7c0d8;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 4px 8px;
    text-align: left;
}
QPushButton#serialStationPaletteButton:hover {
    background-color: #1b2634;
    border-color: rgba(34, 211, 238, 0.35);
    color: #d7def3;
}

/* === App Navigation Rail === */
QFrame#serialStationNavRail {
    background-color: #101218;
    border-right: 1px solid #27313f;
}
QLabel#serialStationNavBrand {
    color: #22d3ee;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 0;
}
/* 导航图标按钮：方形、无边框、激活态强调青软底。 */
QPushButton[objectName^="serialStationNav"] {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px;
    margin: 0 6px;
    min-width: 40px;
    min-height: 40px;
}
QPushButton[objectName^="serialStationNav"]:hover {
    background-color: #1b2634;
}
QPushButton[objectName^="serialStationNav"]:checked {
    background-color: rgba(34, 211, 238, 0.12);
    border-left: 2px solid #22d3ee;
}

/* === OTA Panel === */
QWidget#serialStationOtaPanel {
    background-color: #101218;
}
QLabel#serialStationOtaFieldLabel {
    color: #b7c0d8;
    font-size: 12px;
    font-weight: 600;
}
QComboBox#serialStationOtaProtocolCombo {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}
QFrame#serialStationOtaFileEdit {
    background-color: #0f141d;
    border: 1px solid #334155;
    border-radius: 6px;
    min-height: 28px;
}
QLabel#serialStationOtaFileLabel {
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}
QProgressBar#serialStationOtaProgress {
    background-color: #0f141d;
    border: 1px solid #27313f;
    border-radius: 6px;
    text-align: center;
    color: #d7def3;
    min-height: 28px;
}
QProgressBar#serialStationOtaProgress::chunk {
    background-color: #22d3ee;
    border-radius: 6px;
}
QPlainTextEdit#serialStationOtaLog {
    background-color: #0d1118;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 5px 8px;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}
QLabel#serialStationOtaStatusLabel {
    color: #9aa7bd;
    font-size: 12px;
    padding: 0 8px;
}
QPushButton#serialStationOtaBrowseButton {
    background-color: #151b24;
    color: #b7c0d8;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#serialStationOtaBrowseButton:hover {
    background-color: #1b2634;
    border-color: rgba(34, 211, 238, 0.35);
}
QPushButton#serialStationOtaStartButton {
    background-color: #22d3ee;
    color: #0d1118;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#serialStationOtaStartButton:hover {
    background-color: #67e8f9;
}
QPushButton#serialStationOtaStartButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
}

/* === Buttons === */
QPushButton {
    background-color: #151b24;
    color: #d7def3;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #1b2634;
    border-color: #334155;
}
QPushButton:pressed {
    background-color: #203044;
    border-color: #0891b2;
}
QPushButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
/* 连接类主按钮 — 强调青底 */
QPushButton#serialStationConnectButton,
QPushButton#serialStationConnectSerialButton,
QPushButton#serialStationConnectTcpButton,
QPushButton#serialStationConnectUdpButton {
    background-color: #22d3ee;
    color: #0d1118;
    border: 0px;
    font-weight: 600;
}
QPushButton#serialStationConnectButton:hover,
QPushButton#serialStationConnectSerialButton:hover,
QPushButton#serialStationConnectTcpButton:hover,
QPushButton#serialStationConnectUdpButton:hover {
    background-color: #67e8f9;
}
QPushButton#serialStationConnectButton:pressed,
QPushButton#serialStationConnectSerialButton:pressed,
QPushButton#serialStationConnectTcpButton:pressed,
QPushButton#serialStationConnectUdpButton:pressed {
    background-color: #0891b2;
}
QPushButton#serialStationConnectButton:disabled,
QPushButton#serialStationConnectSerialButton:disabled,
QPushButton#serialStationConnectTcpButton:disabled,
QPushButton#serialStationConnectUdpButton:disabled {
    background-color: #151b24;
    color: #5f6f86;
}
/* 断开按钮 — 危险红 */
QPushButton#serialStationDisconnectButton {
    background-color: rgba(239, 68, 68, 0.10);
    color: #ef4444;
    border: 1px solid #ef4444;
}
QPushButton#serialStationDisconnectButton:hover {
    background-color: #ef4444;
    color: #f8fafc;
}
QPushButton#serialStationDisconnectButton:pressed {
    background-color: #f87171;
}
/* 次要工具按钮 */
QPushButton#serialStationRefreshPortsButton,
QPushButton#serialStationExportLogButton,
QPushButton#serialStationReplayLogButton,
QPushButton#serialStationSaveProfileButton,
QPushButton#serialStationLoadProfileButton,
QPushButton#serialStationClearButton,
QPushButton#serialStationInjectButton,
QPushButton#serialStationSendButton {
    background-color: #151b24;
    color: #b7c0d8;
}
QPushButton#serialStationRefreshPortsButton:hover,
QPushButton#serialStationExportLogButton:hover,
QPushButton#serialStationReplayLogButton:hover,
QPushButton#serialStationSaveProfileButton:hover,
QPushButton#serialStationLoadProfileButton:hover,
QPushButton#serialStationClearButton:hover,
QPushButton#serialStationInjectButton:hover,
QPushButton#serialStationSendButton:hover {
    background-color: #1b2634;
    color: #d7def3;
    border-color: rgba(34, 211, 238, 0.35);
}
/* 发送/注入 — 终端 TX 蓝 */
QPushButton#serialStationSendButton,
QPushButton#serialStationInjectButton {
    color: #38bdf8;
    border-color: #38bdf8;
}
QPushButton#serialStationSendButton:hover,
QPushButton#serialStationInjectButton:hover {
    background-color: #38bdf8;
    color: #f8fafc;
}

/* === Line Edits === */
QLineEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #2563eb;
    selection-color: #f8fafc;
}
QLineEdit:focus {
    border: 1px solid #22d3ee;
    background-color: #111827;
}
QLineEdit:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
QLineEdit::placeholder {
    color: #9aa7bd;
}
QLineEdit#serialStationSendEdit,
QLineEdit#serialStationInjectEdit,
QLineEdit#serialStationLogSearchEdit,
QLineEdit#serialStationLogPathEdit,
QLineEdit#serialStationProfilePathEdit,
QLineEdit#serialStationProfileNameEdit,
QLineEdit#serialStationTcpHostEdit,
QLineEdit#serialStationTcpPortEdit,
QLineEdit#serialStationUdpHostEdit,
QLineEdit#serialStationUdpPortEdit {
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}

/* === ComboBoxes === */
QComboBox {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
    selection-background-color: #203044;
}
QComboBox:hover {
    border-color: rgba(34, 211, 238, 0.35);
}
QComboBox:focus {
    border: 1px solid #22d3ee;
}
QComboBox:disabled {
    background-color: #151b24;
    color: #5f6f86;
    border-color: #27313f;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #151b24;
    color: #d7def3;
    border: 1px solid #27313f;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #203044;
    selection-color: #22d3ee;
    outline: none;
}
QComboBox#serialStationProtocolCombo,
QComboBox#serialStationPortCombo,
QComboBox#serialStationBaudCombo,
QComboBox#serialStationDataBitsCombo,
QComboBox#serialStationParityCombo,
QComboBox#serialStationStopBitsCombo,
QComboBox#serialStationFlowControlCombo,
QComboBox#serialStationCommandHistoryCombo,
QComboBox#serialStationLogFilterCombo {
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
}

/* === Log View (Terminal) === */
QPlainTextEdit#serialStationLogView {
    background-color: #0d1118;
    color: #9aa7bd;
    border: 1px solid #27313f;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    selection-background-color: #2563eb;
    selection-color: #f8fafc;
}

/* === Waveform Preview === */
QWidget#serialStationWaveformPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
/* pyqtgraph PlotWidget：QSS 仅控制背景，绘图区背景在运行时通过
   setBackground 设置，此处保证控件框与面板一致。 */
QWidget#serialStationWaveformPlot,
QGraphicsView#serialStationWaveformPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationWaveformStatusLabel {
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 6px 8px;
}
/* 多通道图例（对齐 VOFA+ 通道色块） */
QWidget#serialStationWaveformLegend {
    background-color: transparent;
    border-top: 1px solid #27313f;
}
QLabel#serialStationWaveformLegendChip {
    background-color: transparent;
    font-size: 12px;
}
/* 游标读数 HUD */
QLabel#serialStationWaveformCursorHud {
    background-color: transparent;
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 4px 8px;
}
/* 富游标 objectName 契约：pyqtgraph InfiniteLine 不可由 QSS 设置样式，
   样式通过运行时 pen 参数设置（强调青/警告黄），此处保留契约占位。 */
QObject#serialStationWaveformCursorX,
QObject#serialStationWaveformCursorY {
    /* no-op */
}
/* === 李萨如（X-Y）面板 === */
QWidget#serialStationLissajousPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QWidget#serialStationLissajousPlot,
QGraphicsView#serialStationLissajousPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationLissajousStatus {
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 4px 8px;
}
/* === 条形图面板 === */
QWidget#serialStationBarChartPanel {
    background-color: #151b24;
    border: 1px solid #27313f;
    border-radius: 8px;
}
QWidget#serialStationBarChartPlot,
QGraphicsView#serialStationBarChartPlot {
    background-color: #0d1118;
    border: none;
}
QLabel#serialStationBarChartStatus {
    color: #9aa7bd;
    font-family: Consolas, "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 4px 8px;
}

/* === Status & Profile Labels === */
QLabel#serialStationStatusLabel {
    color: #f59e0b;
    padding: 4px 8px;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 12px;
    background-color: rgba(245, 158, 11, 0.08);
    font-size: 12px;
    font-weight: 600;
}
QLabel#serialStationProfileLabel {
    color: #9aa7bd;
    font-size: 12px;
    padding: 4px 8px;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === PlainTextEdit Fallback === */
QPlainTextEdit {
    background-color: #0f141d;
    color: #d7def3;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
}

/* === Shortcut objectName contract === */
/* QShortcut 无可视样式，objectName 仅用于测试与可发现性，此处保留契约占位。 */
QObject#serialStationSendShortcut,
QObject#serialStationClearShortcut,
QObject#serialStationRefreshPortsShortcut,
QObject#serialStationCommandPaletteShortcut {
    /* no-op */
}
