/* EmbedDebug - 现代深色主题 (VS Code / Tokyo Night 风格) */

/* 全局背景 */
QMainWindow {
    background-color: #1a1b26;
}

/* 左侧导航树 */
QTreeView {
    background-color: #16161e;
    color: #a9b1d6;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #283457;
    color: #7aa2f7;
}

QTreeView::item:hover {
    background-color: #292e42;
}

/* 工具栏 */
QToolBar {
    background-color: #1a1b26;
    border: none;
    border-bottom: 1px solid #292e42;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #a9b1d6;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #292e42;
    border: 1px solid #3b4261;
}

QToolButton:pressed {
    background-color: #3b4261;
}

QToolButton:disabled {
    background-color: transparent;
    color: #565f89;
    border: 1px solid transparent;
}

QToolButton:checked {
    background-color: #292e42;
    border: 1px solid #7aa2f7;
    color: #7aa2f7;
}

/* 发送区域 */
QLineEdit {
    background-color: #1a1b26;
    color: #9ece6a;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #7aa2f7;
}

QPushButton {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #3b4261;
}

QPushButton:pressed {
    background-color: #414868;
}

QPushButton:disabled {
    background-color: #292e42;
    color: #565f89;
    border-color: #292e42;
}

/* 发送按钮 - 主题色高亮 */
QPushButton#sendButton {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #89b4fa;
}

QPushButton#sendButton:pressed {
    background-color: #6a9af0;
}

QPushButton#sendButton:disabled { background-color: #3b4261; color: #565f89; }

/* 应用定义按钮 - accent高亮 */
QPushButton#applyDefBtn {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#applyDefBtn:hover { background-color: #89b4fa; }
QPushButton#applyDefBtn:pressed { background-color: #6a9af0; }
QPushButton#applyDefBtn:disabled { background-color: #3b4261; color: #565f89; }

/* 状态栏 */
QStatusBar {
    background-color: #16161e;
    color: #565f89;
    border-top: 1px solid #292e42;
    font-size: 12px;
}

/* 分隔器 */
QSplitter::handle {
    background-color: #292e42;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar,
QWidget#quickCommandBar {
    background-color: #1a1b26;
    border-top: 1px solid #292e42;
}

/* 快捷指令按钮 - 统一样式 */
QPushButton#quickCmdEditBtn {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdEditBtn:hover { background-color: #3b4261; }
QPushButton#quickCmdEditBtn:pressed { background-color: #414868; }
QPushButton#quickCmdEditBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

QPushButton#quickCmdAddBtn {
    background-color: #292e42;
    color: #7aa2f7;
    border: 1px solid #3b4261;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#quickCmdAddBtn:hover { background-color: #3b4261; color: #89b4fa; }
QPushButton#quickCmdAddBtn:pressed { background-color: #414868; }
QPushButton#quickCmdAddBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

/* 快捷指令按钮 - 动态命令按钮 */
QPushButton[quickCmdBtn="true"] {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton[quickCmdBtn="true"]:hover { background-color: #3b4261; border-color: #7aa2f7; color: #7aa2f7; }
QPushButton[quickCmdBtn="true"]:pressed { background-color: #414868; }

/* ComboBox */
QComboBox {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #7aa2f7;
}

QComboBox::drop-down {
    border: none;
}

QComboBox:disabled {
    background-color: #292e42;
    color: #565f89;
    border: 1px solid #292e42;
}

QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #a9b1d6;
    selection-background-color: #283457;
}

/* SpinBox */
QSpinBox {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QSpinBox:hover {
    border: 1px solid #7aa2f7;
}

QSpinBox:focus {
    border: 1px solid #7aa2f7;
}

QSpinBox:disabled {
    background-color: #292e42;
    color: #565f89;
    border: 1px solid #292e42;
}

/* CheckBox */
QCheckBox {
    color: #a9b1d6;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3b4261;
    border-radius: 3px;
    background-color: #1a1b26;
}

QCheckBox::indicator:checked {
    background-color: #7aa2f7;
    border: 1px solid #7aa2f7;
}

/* 配置面板标签 */
QLabel {
    color: #9aa5ce;
    font-size: 13px;
}

QGroupBox {
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #89b4fa; }
QPushButton#otaStartBtn:pressed { background-color: #6a9af0; }
QPushButton#otaStartBtn:disabled { background-color: #3b4261; color: #565f89; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #f7768e;
    border: 1px solid #f7768e;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(247,118,142,0.15); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(247,118,142,0.3); }
QPushButton#otaCancelBtn:disabled { color: #3b4261; border-color: #3b4261; }

QProgressBar#otaProgress {
    background-color: #292e42;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #a9b1d6;
}
QProgressBar#otaProgress::chunk {
    background-color: #7aa2f7;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #1a1b26;
    color: #565f89;
    border: 1px solid #292e42;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #16161e;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #565f89;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #f7768e; border-color: #f7768e; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #9ece6a;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #b4f0a0; }
QPushButton#connectBtn[state="connected"] {
    background-color: #f7768e;
    color: #1a1b26;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #ff9e9e; }

/* === SerialConfigPanel 控件 ===*/
QGroupBox {
    font-weight: bold;
    border: 1px solid #292e42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #a9b1d6;
}
QCheckBox#dtrCheck, QCheckBox#rtsCheck {
    spacing: 6px;
    color: #c0caf5;
    font-size: 13px;
}
QCheckBox#dtrCheck::indicator, QCheckBox#rtsCheck::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #3b4261;
    background-color: #1a1b26;
}
QCheckBox#dtrCheck::indicator:checked, QCheckBox#rtsCheck::indicator:checked {
    background-color: #7aa2f7;
    border-color: #7aa2f7;
}
QCheckBox#dtrCheck::indicator:hover, QCheckBox#rtsCheck::indicator:hover {
    border-color: #7aa2f7;
}

/* === 发送栏控件 ===*/
QComboBox#sendModeCombo, QComboBox#newlineCombo {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c0caf5;
    font-size: 12px;
}
QComboBox#sendModeCombo:hover, QComboBox#newlineCombo:hover {
    border-color: #7aa2f7;
}
QComboBox#sendModeCombo::drop-down, QComboBox#newlineCombo::drop-down {
    border: none;
    width: 20px;
}

/* === 工具栏显示模式下拉 ===*/
QComboBox#displayModeCombo {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c0caf5;
    font-size: 12px;
}
QComboBox#displayModeCombo:hover { border-color: #7aa2f7; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #9ece6a; }
QLabel#connStatus[state="disconnected"] { color: #f7768e; }
QLabel#connStatus[state="connecting"] { color: #e0af68; }
QLabel#connStatus[state="error"] { color: #f7768e; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #9ece6a; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #9ece6a; font-size: 11px; }
QLabel#txTotalLabel { color: #f7768e; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #f7768e; font-size: 11px; }
QLabel#elapsedLabel { color: #a9b1d6; font-size: 13px; font-family: monospace; }

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #292e42; }

QLineEdit#searchBarInput {
    background: #3b4261;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #7aa2f7;
}
QLineEdit#searchBarInput:focus { border: 1px solid #7aa2f7; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #3b4261;
    color: #a9b1d6;
    border: 2px solid #f7768e;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #a9b1d6;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #7aa2f7; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #3b4261; border: 1px solid #3b4261; border-radius: 2px;
}

QLabel#searchBarResult { color: #565f89; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #f7768e; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #3b4261; color: #a9b1d6;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #7aa2f7; }
QPushButton#searchBarCloseBtn:pressed { background: #7aa2f7; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #f7768e; }

/* === ProtocolView 协议解析面板 === */
QWidget#protocolView { background-color: #1a1b26; }
QWidget#protocolToolbar {
    background-color: #1a1b26;
    border-bottom: 1px solid #292e42;
}
QLabel#protocolStatusLabel {
    color: #565f89;
    font-size: 12px;
}
QPushButton#protocolClearBtn,
QPushButton#protocolExportBtn {
    background-color: transparent;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#protocolClearBtn:hover,
QPushButton#protocolExportBtn:hover { background-color: #292e42; border-color: #7aa2f7; color: #7aa2f7; }
QPushButton#protocolClearBtn:pressed,
QPushButton#protocolExportBtn:pressed { background-color: #3b4261; }

QTableView#protocolTable {
    background-color: #1a1b26;
    alternate-background-color: #16161e;
    color: #a9b1d6;
    border: none;
    gridline-color: #292e42;
    font-size: 12px;
    selection-background-color: #292e42;
    selection-color: #7aa2f7;
}
QTableView#protocolTable::item {
    padding: 4px 8px;
}

/* ProtocolView 右键上下文菜单 */
QMenu#protocolContextMenu {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu#protocolContextMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu#protocolContextMenu::item:selected {
    background-color: #292e42;
    color: #7aa2f7;
}
QMenu#protocolContextMenu::item:disabled {
    color: #565f89;
}
QMenu#protocolContextMenu::separator {
    height: 1px;
    background-color: #292e42;
    margin: 4px 8px;
}

/* === FrameVisualEditor 帧编辑器 === */
QGroupBox#frameHeaderGroup,
QGroupBox#frameLengthGroup,
QGroupBox#frameChecksumGroup,
QGroupBox#frameFieldGroup {
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QTableWidget#frameFieldTable {
    background-color: #1a1b26;
    alternate-background-color: #16161e;
    color: #a9b1d6;
    border: 1px solid #292e42;
    gridline-color: #292e42;
    font-size: 12px;
    selection-background-color: #292e42;
}
QTableWidget#frameFieldTable::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #16161e;
    color: #565f89;
    border: 1px solid #292e42;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#frameAddFieldBtn {
    background-color: #1a1b26;
    color: #7aa2f7;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameAddFieldBtn:hover { background-color: #292e42; border-color: #7aa2f7; }
QPushButton#frameAddFieldBtn:pressed { background-color: #3b4261; }

QPushButton#frameRemoveFieldBtn {
    background-color: #1a1b26;
    color: #f7768e;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameRemoveFieldBtn:hover { background-color: #292e42; border-color: #f7768e; }
QPushButton#frameRemoveFieldBtn:pressed { background-color: #3b4261; }
