/* EmbedDebug - 现代深色主题 (VS Code / Tokyo Night 风格) */

/*
 * 语义色板定义 — ThemeManager 从此块解析自绘控件颜色
 */
--semantic-BgPrimary: #1a1b26;
--semantic-BgSecondary: #24283b;
--semantic-BgTertiary: #414868;
--semantic-BgHover: #414868;
--semantic-TextPrimary: #c0caf5;
--semantic-TextSecondary: #a9b1d6;
--semantic-TextMuted: #565f89;
--semantic-Accent: #7aa2f7;
--semantic-AccentHover: #a0b8f9;
--semantic-AccentPressed: #6a90e8;
--semantic-Border: #24283b;
--semantic-BorderFocus: #7aa2f7;
--semantic-Success: #9ece6a;
--semantic-Warning: #e0af68;
--semantic-Error: #f7768e;
--semantic-Scrollbar: #414868;
--semantic-ScrollbarHover: #565f89;
--semantic-TermBackground: #1a1b26;
--semantic-TermRxText: #c0caf5;
--semantic-TermTxText: #9ece6a;
--semantic-TermTimestamp: #565f89;
--semantic-TermSelection: #414868;
--semantic-TermSearchHighlight: rgba(224, 175, 104, 80);
--semantic-TermCurrentMatch: rgba(224, 175, 104, 180);


/* 全局背景 */
QMainWindow {
    background-color: #1a1b26;
}

BackgroundWidget {
    background-color: transparent;
}

/* 面板半透明背景 - 让磨砂玻璃效果和背景图透出来 */
QWidget#serialPanel {
    background-color: rgba(22, 22, 30, 160);
    border-radius: 6px;
}

QWidget#rightWidget {
    background-color: rgba(22, 22, 30, 80);
}

QWidget#rightPanel {
    background-color: transparent;
}

/* 左侧导航树 */
QTreeView {
    background-color: #16161e;
    color: #a9b1d6;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QTreeView::item:selected {
    background-color: #283457;
    color: #7aa2f7;
}

QTreeView::item:hover {
    background-color: #292e42;
}

/* 工具栏 */
QToolBar {
    background-color: #1a1b26;
    border: none;
    border-bottom: 1px solid #292e42;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #a9b1d6;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #292e42;
    border: 1px solid #3b4261;
}

QToolButton:pressed {
    background-color: #3b4261;
}

QToolButton:disabled {
    background-color: transparent;
    color: #565f89;
    border: 1px solid transparent;
}

QToolButton:checked {
    background-color: #292e42;
    border: 1px solid #7aa2f7;
    color: #7aa2f7;
}

/* 发送区域 */
QLineEdit {
    background-color: #1a1b26;
    color: #9ece6a;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #7aa2f7;
}

QPushButton {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #3b4261;
}

QPushButton:pressed {
    background-color: #414868;
}

QPushButton:disabled {
    background-color: #292e42;
    color: #565f89;
    border-color: #292e42;
}

/* 发送按钮 - 主题色高亮 */
QPushButton#sendButton {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #89b4fa;
}

QPushButton#sendButton:pressed {
    background-color: #6a9af0;
}

QPushButton#sendButton:disabled { background-color: #3b4261; color: #565f89; }

/* 应用定义按钮 - accent高亮 */
QPushButton#applyDefBtn {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#applyDefBtn:hover { background-color: #89b4fa; }
QPushButton#applyDefBtn:pressed { background-color: #6a9af0; }
QPushButton#applyDefBtn:disabled { background-color: #3b4261; color: #565f89; }

/* 状态栏 */
QStatusBar {
    background-color: #16161e;
    color: #565f89;
    border-top: 1px solid #292e42;
    font-size: 12px;
}
QLabel#rxBytesLabel { color: #9ece6a; font-size: 12px; }
QLabel#txBytesLabel { color: #f7768e; font-size: 12px; }
QLabel#connStatusLbl { font-size: 12px; padding: 0 4px; }

/* 分隔器 */
QSplitter::handle {
    background-color: #292e42;
    width: 1px;
}

/* 快捷指令栏 */
QFrame#quickCommandBar,
QWidget#quickCommandBar {
    background-color: #1a1b26;
    border-top: 1px solid #292e42;
}

/* 快捷指令按钮 - 统一样式 */
QPushButton#quickCmdEditBtn {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#quickCmdEditBtn:hover { background-color: #3b4261; }
QPushButton#quickCmdEditBtn:pressed { background-color: #414868; }
QPushButton#quickCmdEditBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

QPushButton#quickCmdAddBtn {
    background-color: #292e42;
    color: #7aa2f7;
    border: 1px solid #3b4261;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#quickCmdAddBtn:hover { background-color: #3b4261; color: #89b4fa; }
QPushButton#quickCmdAddBtn:pressed { background-color: #414868; }
QPushButton#quickCmdAddBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

/* 快捷指令按钮 - 动态命令按钮 */
QPushButton[quickCmdBtn="true"] {
    background-color: #292e42;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton[quickCmdBtn="true"]:hover { background-color: #3b4261; border-color: #7aa2f7; color: #7aa2f7; }
QPushButton[quickCmdBtn="true"]:pressed { background-color: #414868; }
QPushButton[quickCmdBtn="true"]:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

/* ComboBox */
QComboBox {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #7aa2f7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid #3b4261;
}

QComboBox::down-arrow {
    width: 14px;
    height: 14px;
    image: url(:/icons/dropdown_arrow.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/dropdown_arrow_disabled.svg);
}

QComboBox:disabled {
    background-color: #292e42;
    color: #565f89;
    border: 1px solid #292e42;
}

QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #a9b1d6;
    selection-background-color: #283457;
}

/* SpinBox */
QSpinBox {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QSpinBox:hover {
    border: 1px solid #7aa2f7;
}

QSpinBox:focus {
    border: 1px solid #7aa2f7;
}

QSpinBox:disabled {
    background-color: #292e42;
    color: #565f89;
    border: 1px solid #292e42;
}

/* CheckBox - 统一自定义指示器样式 */
QCheckBox {
    color: #a9b1d6;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3b4261;
    border-radius: 3px;
    background-color: #1a1b26;
}

QCheckBox::indicator:checked {
    background-color: #7aa2f7;
    border: 1px solid #7aa2f7;
}

QCheckBox::indicator:hover {
    border-color: #7aa2f7;
}

QCheckBox::indicator:disabled {
    background-color: #292e42;
    border-color: #292e42;
}

/* 配置面板标签 */
QLabel {
    color: #9aa5ce;
    font-size: 13px;
}

/* QGroupBox - 统一标题样式（字体大小、颜色、间距） */
QGroupBox {
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #9aa5ce;
}

/* === OTA Widget === */
QPushButton#otaStartBtn {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#otaStartBtn:hover { background-color: #89b4fa; }
QPushButton#otaStartBtn:pressed { background-color: #6a9af0; }
QPushButton#otaStartBtn:disabled { background-color: #3b4261; color: #565f89; }

QPushButton#otaCancelBtn {
    background-color: transparent;
    color: #f7768e;
    border: 1px solid #f7768e;
    border-radius: 4px;
}
QPushButton#otaCancelBtn:hover { background-color: rgba(247,118,142,0.15); }
QPushButton#otaCancelBtn:pressed { background-color: rgba(247,118,142,0.3); }
QPushButton#otaCancelBtn:disabled { color: #3b4261; border-color: #3b4261; }

QProgressBar#otaProgress {
    background-color: #292e42;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #a9b1d6;
}
QProgressBar#otaProgress::chunk {
    background-color: #7aa2f7;
    border-radius: 4px;
}

QTextEdit#otaLogView {
    background-color: #1a1b26;
    color: #565f89;
    border: 1px solid #292e42;
    border-radius: 4px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QTreeView#otaHistoryView {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 4px;
    font-size: 12px;
}
QTreeView#otaHistoryView::alternate-background-color {
    background-color: #16161e;
}

QPushButton#otaClearHistory {
    background-color: transparent;
    color: #565f89;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 2px 8px;
}
QPushButton#otaClearHistory:hover { color: #f7768e; border-color: #f7768e; }
QPushButton#otaClearHistory:pressed { background-color: rgba(247,118,142,0.15); }
QPushButton#otaClearHistory:disabled { color: #3b4261; border-color: #3b4261; }

/* === SerialConfigPanel 连接按钮 === */
QPushButton#connectBtn {
    background-color: #9ece6a;
    color: #1a1b26;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#connectBtn:hover { background-color: #b4f0a0; }
QPushButton#connectBtn:pressed { background-color: #8ce070; }
QPushButton#connectBtn:disabled { background-color: #3b4261; color: #565f89; }
QPushButton#connectBtn[state="connected"] {
    background-color: #f7768e;
    color: #1a1b26;
}
QPushButton#connectBtn[state="connected"]:hover { background-color: #ff9e9e; }
QPushButton#connectBtn[state="connected"]:pressed { background-color: #e88aa0; }
QPushButton#connectBtn[state="connected"]:disabled { background-color: #3b4261; color: #565f89; }
QPushButton#connectBtn[state="connecting"] {
    background-color: #e0af68;
    color: #1a1b26;
}

QLabel#driverInfoLbl {
    font-size: 11px;
    color: #565f89;
    padding: 4px;
}

QPushButton#refreshBtn {
    background-color: transparent;
    border: 1px solid #292e42;
    border-radius: 4px;
    color: #565f89;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#refreshBtn:hover {
    background-color: #292e42;
    border-color: #7aa2f7;
    color: #a9b1d6;
}
QPushButton#refreshBtn:pressed { background-color: #3b4261; }
QPushButton#refreshBtn:disabled {
    background-color: transparent;
    border-color: #1a1b26;
    color: #3b4261;
}

/* === SerialConfigPanel 控件 ===*/
QCheckBox#dtrCheck, QCheckBox#rtsCheck {
    spacing: 6px;
    color: #c0caf5;
    font-size: 13px;
}
QCheckBox#dtrCheck::indicator, QCheckBox#rtsCheck::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #3b4261;
    background-color: #1a1b26;
}
QCheckBox#dtrCheck::indicator:checked, QCheckBox#rtsCheck::indicator:checked {
    background-color: #7aa2f7;
    border-color: #7aa2f7;
}
QCheckBox#dtrCheck::indicator:hover, QCheckBox#rtsCheck::indicator:hover {
    border-color: #7aa2f7;
}

/* === 发送栏控件 ===*/
QFrame#sendBarFrame {
    background-color: rgba(22, 22, 30, 180);
    border-top: 1px solid #292e42;
}
QComboBox#sendModeCombo, QComboBox#newlineCombo {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c0caf5;
    font-size: 12px;
}
QComboBox#sendModeCombo:hover, QComboBox#newlineCombo:hover {
    border-color: #7aa2f7;
}
QComboBox#sendModeCombo::drop-down, QComboBox#newlineCombo::drop-down {
    border: none;
    width: 20px;
}

/* === 工具栏显示模式下拉 ===*/
QComboBox#displayModeCombo {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c0caf5;
    font-size: 12px;
}
QComboBox#displayModeCombo:hover { border-color: #7aa2f7; }

/* === 连接状态标签 === */
QLabel#connStatus { font-size: 12px; }
QLabel#connStatus[state="connected"] { color: #9ece6a; }
QLabel#connStatus[state="disconnected"] { color: #f7768e; }
QLabel#connStatus[state="connecting"] { color: #e0af68; }
QLabel#connStatus[state="error"] { color: #f7768e; }

/* === 数据统计面板 === */
QFrame#statsFrame {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 6px;
    padding: 6px;
}
QLabel#rxTotalLabel { color: #9ece6a; font-size: 13px; font-weight: bold; }
QLabel#rxRateLabel { color: #9ece6a; font-size: 11px; }
QLabel#txTotalLabel { color: #f7768e; font-size: 13px; font-weight: bold; }
QLabel#txRateLabel { color: #f7768e; font-size: 11px; }
QLabel#elapsedLabel { color: #a9b1d6; font-size: 13px; font-family: monospace; }

/* === 终端搜索栏 === */
QWidget#terminalSearchBar { background: #292e42; }

QLineEdit#searchBarInput {
    background: #3b4261;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #7aa2f7;
}
QLineEdit#searchBarInput:focus { border: 1px solid #7aa2f7; }
QLineEdit#searchBarInput[hasError="true"] {
    background: #3b4261;
    color: #a9b1d6;
    border: 2px solid #f7768e;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox#searchBarRegexCheck,
QCheckBox#searchBarHexCheck {
    color: #a9b1d6;
    spacing: 4px;
}
QCheckBox#searchBarRegexCheck::indicator,
QCheckBox#searchBarHexCheck::indicator {
    width: 14px; height: 14px;
}
QCheckBox#searchBarRegexCheck::indicator:checked,
QCheckBox#searchBarHexCheck::indicator:checked {
    background: #7aa2f7; border-radius: 2px;
}
QCheckBox#searchBarRegexCheck::indicator:unchecked,
QCheckBox#searchBarHexCheck::indicator:unchecked {
    background: #3b4261; border: 1px solid #3b4261; border-radius: 2px;
}

QLabel#searchBarResult { color: #565f89; padding: 0 4px; }
QLabel#searchBarResult[hasError="true"] { color: #f7768e; padding: 0 4px; }

QPushButton#searchBarCloseBtn {
    background: #3b4261; color: #a9b1d6;
    border: none; border-radius: 4px; font-weight: bold;
}
QPushButton#searchBarCloseBtn:hover { background: #7aa2f7; }
QPushButton#searchBarCloseBtn:pressed { background: #7aa2f7; }
QPushButton#searchBarCloseBtn:disabled { background: #3b4261; color: #565f89; }

/* === 发送输入框错误状态 === */
QLineEdit#sendInput[hasError="true"] { border: 2px solid #f7768e; }

/* === ProtocolView 协议解析面板 === */
QWidget#protocolView { background-color: #1a1b26; }
QWidget#protocolToolbar {
    background-color: #1a1b26;
    border-bottom: 1px solid #292e42;
}
QLabel#protocolStatusLabel {
    color: #565f89;
    font-size: 12px;
}
QPushButton#protocolClearBtn,
QPushButton#protocolExportBtn {
    background-color: transparent;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#protocolClearBtn:hover,
QPushButton#protocolExportBtn:hover { background-color: #292e42; border-color: #7aa2f7; color: #7aa2f7; }
QPushButton#protocolClearBtn:pressed,
QPushButton#protocolExportBtn:pressed { background-color: #3b4261; }
QPushButton#protocolClearBtn:disabled,
QPushButton#protocolExportBtn:disabled { background-color: transparent; color: #565f89; border-color: #292e42; }

QTableView#protocolTable {
    background-color: #1a1b26;
    alternate-background-color: #16161e;
    color: #a9b1d6;
    border: none;
    gridline-color: #292e42;
    font-size: 12px;
    selection-background-color: #292e42;
    selection-color: #7aa2f7;
}
QTableView#protocolTable::item {
    padding: 4px 8px;
}

/* ProtocolView 右键上下文菜单 */
QMenu#protocolContextMenu {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu#protocolContextMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu#protocolContextMenu::item:selected {
    background-color: #292e42;
    color: #7aa2f7;
}
QMenu#protocolContextMenu::item:disabled {
    color: #565f89;
}
QMenu#protocolContextMenu::separator {
    height: 1px;
    background-color: #292e42;
    margin: 4px 8px;
}

/* === FrameVisualEditor 帧编辑器 === */
QGroupBox#frameHeaderGroup,
QGroupBox#frameLengthGroup,
QGroupBox#frameChecksumGroup,
QGroupBox#frameFieldGroup {
    color: #a9b1d6;
    border: 1px solid #292e42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QTableWidget#frameFieldTable {
    background-color: #1a1b26;
    alternate-background-color: #16161e;
    color: #a9b1d6;
    border: 1px solid #292e42;
    gridline-color: #292e42;
    font-size: 12px;
    selection-background-color: #292e42;
}
QTableWidget#frameFieldTable::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #16161e;
    color: #565f89;
    border: 1px solid #292e42;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#frameAddFieldBtn {
    background-color: #1a1b26;
    color: #7aa2f7;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameAddFieldBtn:hover { background-color: #292e42; border-color: #7aa2f7; }
QPushButton#frameAddFieldBtn:pressed { background-color: #3b4261; }
QPushButton#frameAddFieldBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

QPushButton#frameRemoveFieldBtn {
    background-color: #1a1b26;
    color: #f7768e;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#frameRemoveFieldBtn:hover { background-color: #292e42; border-color: #f7768e; }
QPushButton#frameRemoveFieldBtn:pressed { background-color: #3b4261; }
QPushButton#frameRemoveFieldBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

/* === 背景设置弹出面板 === */
QWidget#bgSettingsPopup {
    background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 8px;
}
QSlider#bgBlurSlider, QSlider#bgOpacitySlider {
    background: transparent;
    min-height: 20px;
}
QSlider#bgBlurSlider::groove:horizontal, QSlider#bgOpacitySlider::groove:horizontal {
    height: 4px;
    background: #292e42;
    border-radius: 2px;
}
QSlider#bgBlurSlider::handle:horizontal, QSlider#bgOpacitySlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #7aa2f7;
    border-radius: 7px;
}
QSlider#bgBlurSlider::handle:horizontal:hover, QSlider#bgOpacitySlider::handle:horizontal:hover {
    background: #89b4fa;
}

QSlider#bgBlurSlider::handle:horizontal:disabled, QSlider#bgOpacitySlider::handle:horizontal:disabled {
    background: #414868;
}

QPushButton#bgSelectImageBtn {
    background-color: #292e42;
    color: #7aa2f7;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgSelectImageBtn:hover { background-color: #3b4261; border-color: #7aa2f7; }
QPushButton#bgSelectImageBtn:pressed { background-color: #414868; }
QPushButton#bgSelectImageBtn:disabled { background-color: #292e42; color: #565f89; border-color: #292e42; }

QPushButton#bgResetBtn {
    background-color: transparent;
    color: #565f89;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#bgResetBtn:hover { color: #f7768e; border-color: #f7768e; }
QPushButton#bgResetBtn:pressed { background-color: rgba(247,118,142,0.15); }
QPushButton#bgResetBtn:disabled { color: #3b4261; border-color: #3b4261; }

/* === QScrollBar 滚动条 - 现代极细圆角风格 === */

/* 垂直滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #292e42;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #3b4261;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #292e42;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #3b4261;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* === QToolTip 工具提示 === */
QToolTip {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* === QMenu 通用菜单样式 - 所有菜单统一风格 === */
QMenu {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: #292e42;
    color: #7aa2f7;
}
QMenu::item:disabled {
    color: #565f89;
}
QMenu::separator {
    height: 1px;
    background-color: #292e42;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* === 工具栏下拉框 - 布局/主题/语言选择 === */
QComboBox#layoutCombo,
QComboBox#themeCombo,
QComboBox#langCombo {
    background-color: #292e42;
    border: 1px solid #3b4261;
    border-radius: 4px;
    padding: 4px 8px;
    color: #a9b1d6;
    font-size: 12px;
    min-width: 80px;
}
QComboBox#layoutCombo:hover,
QComboBox#themeCombo:hover,
QComboBox#langCombo:hover {
    border-color: #7aa2f7;
}
QComboBox#layoutCombo:disabled,
QComboBox#themeCombo:disabled,
QComboBox#langCombo:disabled {
    background-color: #292e42;
    color: #565f89;
    border-color: #292e42;
}

/* === PortWatcher 提示文字样式 === */
QLabel#driverInfoLbl {
    font-size: 11px;
    color: #565f89;
    padding: 4px 8px;
    background-color: transparent;
}